<div class="product-card product-card--placeholder">
  <div class="product-card__image-wrap">
    <div class="product-card__placeholder">
      {{ 'product-' | append: index | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
  </div>
  <div class="product-card__info">
    <p class="product-card__vendor placeholder-text">Brand Name</p>
    <h3 class="product-card__title placeholder-text">Organic Cotton Onesie</h3>
    <div class="product-card__price">
      <span class="price">{{ 3400 | money }}</span>
    </div>
  </div>
</div>
