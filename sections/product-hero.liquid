{% comment %}SECTION: PRODUCT HERO{% endcomment %}
<section class="product-hero" data-section-id="{{ section.id }}" data-product-id="{{ product.id }}">
  <div class="container">
    <div class="product-layout">

      <!-- GALLERY -->
      {% assign g_mode_raw = section.settings.gallery_mode | default: 'global' %}
      {% if g_mode_raw == 'global' or g_mode_raw == blank %}
        {% assign g_mode = settings.global_gallery_mode | default: 'slideshow' %}
      {% else %}
        {% assign g_mode = g_mode_raw %}
      {% endif %}
      {% assign g_gap    = section.settings.scroll_gap    | default: 6 %}
      {% assign g_aspect = section.settings.scroll_aspect | default: '3/4' %}
      {% assign g_first  = settings.grid_first_image_ratio   | default: '3/4' %}
      {% assign g_sec    = settings.grid_secondary_ratio      | default: '1/1' %}
      {% assign g_sticky = section.settings.scroll_sticky_thumbs %}
      {% if g_sticky == nil %}{% assign g_sticky = true %}{% endif %}

      <div class="product-gallery{% if g_sticky and g_mode == 'scroll' %} gallery--sticky-thumbs{% endif %}"
           data-gallery-mode="{{ g_mode }}"
           style="--scroll-gap:{{ g_gap }}px;--scroll-aspect:{{ g_aspect }};--grid-first-ratio:{{ g_first }};--grid-sec-ratio:{{ g_sec }};">

        <!-- Thumbs -->
        <div class="gallery-thumbs" id="gallery-thumbs">
          {% for image in product.images %}
            <button class="gallery-thumb {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }}">
              <img src="{{ image | img_url: '150x' }}" alt="{{ image.alt | default: product.title }}" loading="lazy">
            </button>
          {% endfor %}
        </div>

        <!-- Main -->
        <div class="gallery-main" id="gallery-main">

          {% if g_mode == 'scroll' %}
            <div class="gallery-scroll-stack" id="gallery-scroll-track">
              {% for image in product.images %}
                <div class="gallery-scroll-item" data-index="{{ forloop.index0 }}" id="gallery-scroll-{{ forloop.index0 }}">
                  <img src="{{ image | img_url: '1200x' }}"
                       srcset="{{ image | img_url: '600x' }} 600w, {{ image | img_url: '1200x' }} 1200w"
                       alt="{{ image.alt | default: product.title }}"
                       class="gallery-image gallery-image--scroll"
                       {% if forloop.first %}loading="eager"{% else %}loading="lazy"{% endif %}>
                </div>
              {% endfor %}
              {% if product.images.size == 0 %}
                <div class="gallery-scroll-item"><div class="gallery-placeholder">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div></div>
              {% endif %}
            </div>

          {% elsif g_mode == 'grid' %}
            <div class="gallery-grid-stack" id="gallery-grid-track">
              {% for image in product.images %}
                {% if forloop.first %}
                  <div class="gallery-grid-item gallery-grid-item--full" data-index="0">
                    <img src="{{ image | img_url: '1200x' }}"
                         srcset="{{ image | img_url: '600x' }} 600w, {{ image | img_url: '1200x' }} 1200w"
                         sizes="60vw"
                         alt="{{ image.alt | default: product.title }}"
                         class="gallery-grid-img" loading="eager">
                  </div>
                {% else %}
                  <div class="gallery-grid-item gallery-grid-item--half" data-index="{{ forloop.index0 }}">
                    <img src="{{ image | img_url: '800x' }}"
                         srcset="{{ image | img_url: '400x' }} 400w, {{ image | img_url: '800x' }} 800w"
                         sizes="30vw"
                         alt="{{ image.alt | default: product.title }}"
                         class="gallery-grid-img" loading="lazy">
                  </div>
                {% endif %}
              {% endfor %}
              {% if product.images.size == 0 %}
                <div class="gallery-grid-item gallery-grid-item--full"><div class="gallery-placeholder">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div></div>
              {% endif %}
            </div>

          {% else %}
            <div class="gallery-main__inner" id="gallery-track">
              {% for image in product.images %}
                <div class="gallery-slide {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}">
                  <img src="{{ image | img_url: '1200x' }}"
                       srcset="{{ image | img_url: '600x' }} 600w, {{ image | img_url: '1200x' }} 1200w"
                       alt="{{ image.alt | default: product.title }}"
                       class="gallery-image"
                       {% if forloop.first %}loading="eager"{% else %}loading="lazy"{% endif %}
                       data-zoom="{{ image | img_url: '2000x' }}">
                </div>
              {% endfor %}
              {% if product.images.size == 0 %}
                <div class="gallery-slide is-active"><div class="gallery-placeholder">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div></div>
              {% endif %}
            </div>
          {% endif %}

          <div class="gallery-zoom-hint">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
            Hover to zoom
          </div>
          <button class="gallery-arrow gallery-arrow--prev" id="gallery-prev" aria-label="Previous image">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <button class="gallery-arrow gallery-arrow--next" id="gallery-next" aria-label="Next image">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="9 18 15 12 9 6"/></svg>
          </button>

          <!-- New arrival badge (top-left) -->
          {% if product.tags contains 'new' %}
            <div class="product-badge product-badge--new">{{ section.settings.new_badge_text | default: 'New Arrival' }}</div>
          {% elsif product.compare_at_price > product.price %}
            <div class="product-badge product-badge--sale">Sale</div>
          {% endif %}

          <!-- Discount badge (top-right) — ONLY when the variant genuinely has a
               compare-at price above its price. Not derived from bundle tiers or
               the custom.badge_text metafield (that can hold a bundle % with no
               matching compare_at_price). The bundle widget below is unaffected. -->
          {% if product.compare_at_price > product.price %}
            {% assign saving_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
            <div class="product-badge product-badge--discount">{{ saving_pct }}% OFF</div>
          {% endif %}

        </div><!-- /gallery-main -->
      </div><!-- /product-gallery -->

      <!-- INFO PANEL -->
      <div class="product-info" id="product-info">

        <nav class="product-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>›</span>
          {% if product.collections.first %}
            <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
            <span>›</span>
          {% endif %}
          <span>{{ product.title }}</span>
        </nav>

        <!-- Title row -->
        <div class="product-title-row">
          <h1 class="product-title">{{ product.title }}</h1>
        </div>

        <!-- Price row: price left, share icons right -->
        {% assign share_url     = shop.url | append: product.url %}
        {% assign share_message = product.title | append: ' - ' | append: shop.name %}
        {% assign share_image   = product.featured_image | img_url: '600x' | prepend: 'https:' %}
        {% assign share_enabled = false %}
        {% if section.settings.share_whatsapp or section.settings.share_facebook or section.settings.share_twitter or section.settings.share_pinterest or section.settings.share_instagram or section.settings.share_email or section.settings.share_copy_link %}
          {% assign share_enabled = true %}
        {% endif %}

        <div class="product-price-row">
          <div class="product-price-wrap">
            <div class="product-price-block">
              <span class="product-price {% if product.compare_at_price > product.price %}product-price--sale{% endif %}" id="product-price">{{ product.price | money }}</span>
              <span class="product-price product-price--compare" id="product-compare-price"{% unless product.compare_at_price > product.price %} style="display:none;"{% endunless %}>{{ product.compare_at_price | money }}</span>
              {% if product.compare_at_price > product.price %}
                <span class="product-savings">Save {{ product.compare_at_price | minus: product.price | money }}</span>
              {% endif %}
            </div>
            <p class="product-tax-note">{{ section.settings.tax_note | default: 'Inclusive of all taxes' }}</p>
          </div>

          {% if share_enabled %}
            <div class="product-share-inline">
              {% if section.settings.share_whatsapp %}
                <a class="share-btn-sm share-btn--whatsapp" href="https://wa.me/?text={{ share_message | url_encode }}%20{{ share_url | url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on WhatsApp" data-tooltip="WhatsApp">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 1.999c-5.524 0-9.999 4.475-9.999 9.999 0 1.76.463 3.411 1.269 4.845L2 21.998l5.28-1.274A9.96 9.96 0 0 0 12.031 22c5.524 0 9.999-4.475 9.999-9.999 0-5.525-4.475-10-9.999-10zm5.539 13.705c-.23.647-1.347 1.237-1.849 1.281-.47.041-.912.205-3.068-.637-2.595-1.02-4.254-3.668-4.381-3.838-.128-.17-1.041-1.384-1.041-2.638s.659-1.875.893-2.132c.233-.257.509-.321.679-.321.17 0 .34.001.489.009.157.008.367-.06.574.438.213.514.722 1.773.786 1.901.064.127.106.277.021.444-.085.167-.128.27-.255.416-.128.146-.27.326-.384.437-.128.124-.262.258-.113.506.149.247.663 1.093 1.425 1.77 1.011.9 1.862 1.181 2.12 1.309.257.128.406.106.556-.064.149-.171.638-.744.808-.999.17-.255.34-.213.574-.128.234.086 1.489.702 1.744.83.255.127.425.191.489.298.063.106.063.613-.167 1.259z"/></svg>
                </a>
              {% endif %}
              {% if section.settings.share_facebook %}
                <a class="share-btn-sm share-btn--facebook" href="https://www.facebook.com/sharer/sharer.php?u={{ share_url | url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook" data-tooltip="Facebook">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                </a>
              {% endif %}
              {% if section.settings.share_twitter %}
                <a class="share-btn-sm share-btn--twitter" href="https://twitter.com/intent/tweet?text={{ share_message | url_encode }}&url={{ share_url | url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on X" data-tooltip="X / Twitter">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                </a>
              {% endif %}
              {% if section.settings.share_pinterest %}
                <a class="share-btn-sm share-btn--pinterest" href="https://pinterest.com/pin/create/button/?url={{ share_url | url_encode }}&media={{ share_image | url_encode }}&description={{ share_message | url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on Pinterest" data-tooltip="Pinterest">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
                </a>
              {% endif %}
              {% if section.settings.share_email %}
                <a class="share-btn-sm share-btn--email" href="mailto:?subject={{ share_message | url_encode }}&body={{ share_url | url_encode }}" aria-label="Share via Email" data-tooltip="Email">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                </a>
              {% endif %}
              {% if section.settings.share_copy_link %}
                <button class="share-btn-sm share-btn--copy" id="share-copy-link" data-url="{{ share_url }}" aria-label="Copy link" data-tooltip="Copy Link" type="button">
                  <svg class="icon-copy" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                  <svg class="icon-check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none;"><polyline points="20 6 9 17 4 12"/></svg>
                </button>
              {% endif %}
            </div>
          {% endif %}
        </div>

        {% comment %} App-block slot (e.g. app star-rating / badge widget). Empty and inert until an app block is added in the Theme Editor. {% endcomment %}
        {% for block in section.blocks %}
          {% if block.type == '@app' %}{% render block %}{% endif %}
        {% endfor %}

        <!-- Bundle nudge (BXGY) -->
        <div class="product-bundle-nudge" id="bundle-nudge"
          {% if product.metafields.custom.discount == 'BXGY' %}data-bxgy="true"{% endif %}>
          <div class="pbn-header">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <span>{{ section.settings.bundle_label | default: 'Bundle &amp; Save' }}</span>
            <em>{{ section.settings.bxgy_note | default: 'Applies to Bundle &amp; Save products' }}</em>
          </div>
          <div class="pbn-tiers">
            <div class="pbn-tier" id="pbn-tier-1"><span class="pbn-tier__qty">5%</span><span class="pbn-tier__label">off</span><span class="pbn-tier__items">Buy 2</span></div>
            <div class="pbn-tier" id="pbn-tier-2"><span class="pbn-tier__qty">10%</span><span class="pbn-tier__label">off</span><span class="pbn-tier__items">Buy 3</span></div>
            <div class="pbn-tier" id="pbn-tier-3"><span class="pbn-tier__qty">20%</span><span class="pbn-tier__label">off</span><span class="pbn-tier__items">Buy 5+</span></div>
          </div>
        </div>

        <!-- Variant form -->
        <div class="product-form-wrap">
          {% form 'product', product, id: 'product-form', class: 'product-form' %}
            <input type="hidden" name="id" id="variant-id" value="{{ product.selected_or_first_available_variant.id }}">

            {% for option in product.options_with_values %}
              {% if option.name == 'Color' or option.name == 'Colour' %}
                <div class="option-block" data-option-index="{{ forloop.index0 }}">
                  <div class="option-label-row">
                    <span class="option-label">{{ option.name }}</span>
                    <span class="option-selected-value" id="selected-color">{{ product.selected_or_first_available_variant.options[forloop.index0] }}</span>
                  </div>
                  <div class="color-swatches" role="radiogroup" aria-label="Select {{ option.name }}">
                    {% for value in option.values %}
                      <label class="color-swatch-label" title="{{ value }}">
                        <input type="radio" name="option{{ forloop.parentloop.index }}" value="{{ value }}" class="color-swatch-input" data-option-index="{{ forloop.parentloop.index0 }}" {% if product.selected_or_first_available_variant.options[forloop.parentloop.index0] == value %}checked{% endif %}>
                        <span class="color-swatch-dot" style="background-color: {{ value | handleize }};" aria-hidden="true"><span class="swatch-tooltip">{{ value }}</span></span>
                      </label>
                    {% endfor %}
                  </div>
                </div>
              {% elsif option.name == 'Size' %}
                <div class="option-block" data-option-index="{{ forloop.index0 }}">
                  <div class="option-label-row">
                    <span class="option-label">Size</span>
                    <span class="option-selected-value" id="selected-size">{{ product.selected_or_first_available_variant.options[forloop.index0] }}</span>
                    <button type="button" class="size-guide-link" id="size-guide-trigger">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 12h20M17 5l-5 7-5-7"/></svg>
                      Size Guide
                    </button>
                  </div>
                  <div class="size-buttons" role="radiogroup" aria-label="Select Size">
                    {% assign sel_variant = product.selected_or_first_available_variant %}
                    {% for value in option.values %}
                      {% comment %} A size is available only if the variant formed by
                         (currently-selected other options + this size) exists AND is
                         in stock — not a global "any variant with this size" check. {% endcomment %}
                      {% assign size_opt_index = forloop.parentloop.index0 %}
                      {% assign size_available = false %}
                      {% for variant in product.variants %}
                        {% if variant.available and variant.options[size_opt_index] == value %}
                          {% assign others_match = true %}
                          {% for pov in product.options_with_values %}
                            {% assign k = forloop.index0 %}
                            {% if k != size_opt_index and variant.options[k] != sel_variant.options[k] %}
                              {% assign others_match = false %}
                            {% endif %}
                          {% endfor %}
                          {% if others_match %}{% assign size_available = true %}{% endif %}
                        {% endif %}
                      {% endfor %}
                      <label class="size-btn-label {% unless size_available %}is-sold-out{% endunless %}">
                        <input type="radio" name="option{{ forloop.parentloop.index }}" value="{{ value }}" class="size-btn-input" data-option-index="{{ forloop.parentloop.index0 }}" {% if product.selected_or_first_available_variant.options[forloop.parentloop.index0] == value %}checked{% endif %} {% unless size_available %}disabled{% endunless %}>
                        <span class="size-btn">{{ value }}</span>
                      </label>
                    {% endfor %}
                  </div>
                </div>
              {% else %}
                <div class="option-block" data-option-index="{{ forloop.index0 }}">
                  <div class="option-label-row">
                    <span class="option-label">{{ option.name }}</span>
                    <span class="option-selected-value">{{ product.selected_or_first_available_variant.options[forloop.index0] }}</span>
                  </div>
                  <div class="size-buttons" role="radiogroup" aria-label="Select {{ option.name }}">
                    {% for value in option.values %}
                      <label class="size-btn-label">
                        <input type="radio" name="option{{ forloop.parentloop.index }}" value="{{ value }}" class="size-btn-input" data-option-index="{{ forloop.parentloop.index0 }}" {% if product.selected_or_first_available_variant.options[forloop.parentloop.index0] == value %}checked{% endif %}>
                        <span class="size-btn">{{ value }}</span>
                      </label>
                    {% endfor %}
                  </div>
                </div>
              {% endif %}
            {% endfor %}

            <!-- Qty + ATC row (hidden when selected variant is out of stock) -->
            <div class="qty-atc-row" id="qty-atc-row">
              <div class="qty-inline">
                <span class="qty-inline__label">{{ section.settings.quantity_label | default: 'Qty' }}</span>
                <div class="qty-selector">
                  <button type="button" class="qty-selector-btn" id="qty-minus">-</button>
                  <input type="number" name="quantity" id="product-quantity" value="1" min="1" max="99" class="qty-selector-input">
                  <button type="button" class="qty-selector-btn" id="qty-plus">+</button>
                </div>
              </div>
              <button type="submit" name="add" id="add-to-cart-btn" class="btn btn--primary btn--add-to-cart qty-atc-row__btn" data-add-label="{{ section.settings.add_to_cart_text | default: 'Add to Basket' }}" data-sold-out-label="{{ section.settings.sold_out_text | default: 'Sold Out' }}" {% unless product.available %}disabled{% endunless %}>
                <span id="add-to-cart-text">{% if product.available %}{{ section.settings.add_to_cart_text | default: 'Add to Basket' }}{% else %}{{ section.settings.sold_out_text | default: 'Sold Out' }}{% endif %}</span>
                <svg class="btn-cart-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
              </button>
              <button type="button" class="btn-wishlist" id="wishlist-btn" aria-label="Add to wishlist">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              </button>
            </div>

            <!-- Notify Me row (shown only when selected variant is out of stock) -->
            <div class="notify-me-row" id="notify-me-row" style="display:none;">
              <p class="notify-me-label">This variant is currently out of stock</p>
              <button type="button" class="btn btn--ghost btn--full notify-me-btn" id="notify-me-btn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                Notify Me When Available
              </button>
            </div>
          {% endform %}
        </div>

        <!-- Trust badges -->
        {% if section.blocks.size > 0 %}
          <div class="product-trust-badges product-trust-badges--custom" style="--badge-size: {{ section.settings.badge_size }}px;">
            {% for block in section.blocks %}
              {% if block.type == 'trust_badge' %}
                <div class="trust-badge" {{ block.shopify_attributes }}>
                  {% if block.settings.icon == 'shield' %}<svg width="{{ section.settings.badge_size }}" height="{{ section.settings.badge_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                  {% elsif block.settings.icon == 'leaf' %}<svg width="{{ section.settings.badge_size }}" height="{{ section.settings.badge_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
                  {% elsif block.settings.icon == 'truck' %}<svg width="{{ section.settings.badge_size }}" height="{{ section.settings.badge_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                  {% elsif block.settings.icon == 'refresh' %}<svg width="{{ section.settings.badge_size }}" height="{{ section.settings.badge_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.5"/></svg>
                  {% elsif block.settings.icon == 'heart' %}<svg width="{{ section.settings.badge_size }}" height="{{ section.settings.badge_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                  {% elsif block.settings.icon == 'star' %}<svg width="{{ section.settings.badge_size }}" height="{{ section.settings.badge_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                  {% elsif block.settings.icon == 'check' %}<svg width="{{ section.settings.badge_size }}" height="{{ section.settings.badge_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="20 6 9 17 4 12"/></svg>
                  {% elsif block.settings.icon == 'lock' %}<svg width="{{ section.settings.badge_size }}" height="{{ section.settings.badge_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                  {% elsif block.settings.icon == 'smile' %}<svg width="{{ section.settings.badge_size }}" height="{{ section.settings.badge_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
                  {% elsif block.settings.icon == 'custom' and block.settings.custom_icon != blank %}<img src="{{ block.settings.custom_icon | img_url: '40x' }}" alt="" style="width:{{ section.settings.badge_size }}px;height:{{ section.settings.badge_size }}px;object-fit:contain;">
                  {% else %}<svg width="{{ section.settings.badge_size }}" height="{{ section.settings.badge_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                  {% endif %}
                  <span>{{ block.settings.text }}</span>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        <!-- Accordions -->
        <div class="product-accordions">
          {% if product.description != blank %}
          <div class="accordion is-open">
            <button class="accordion-trigger" aria-expanded="true">
              <span>Description</span>
              <svg class="accordion-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="18 15 12 9 6 15"/></svg>
            </button>
            <div class="accordion-body">
              <div class="product-description rte">{{ product.description }}</div>
            </div>
          </div>
          {% endif %}
          {% if section.settings.care_instructions != blank %}
            <div class="accordion">
              <button class="accordion-trigger" aria-expanded="false">
                <span>Care Instructions</span>
                <svg class="accordion-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="18 15 12 9 6 15"/></svg>
              </button>
              <div class="accordion-body" style="display:none;">
                <p>{{ section.settings.care_instructions }}</p>
              </div>
            </div>
          {% endif %}
          <div class="accordion">
            <button class="accordion-trigger" aria-expanded="false">
              <span>Shipping &amp; Returns</span>
              <svg class="accordion-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="18 15 12 9 6 15"/></svg>
            </button>
            <div class="accordion-body" style="display:none;">
              <p>{{ section.settings.shipping_info | default: 'Free standard shipping on orders over Rs. 1500. Returns accepted within 30 days.' }}</p>
            </div>
          </div>
        </div>

      </div><!-- /product-info -->
    </div><!-- /product-layout -->
  </div><!-- /container -->
</section>

<!-- Size Guide Modal -->
<div class="modal-overlay" id="size-guide-overlay" aria-hidden="true">
  <div class="modal size-guide-modal" role="dialog" aria-modal="true" aria-labelledby="size-guide-title">
    <div class="modal__header">
      <h3 class="modal__title" id="size-guide-title">Size Guide</h3>
      <button class="modal__close" id="size-guide-close" aria-label="Close size guide">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="modal__body">
      <p class="size-guide-intro">All measurements are approximate. When between sizes, we recommend sizing up for comfort.</p>
      <div class="size-guide-table-wrap">
        <table class="size-table size-table--popup">
          <thead><tr><th>Size</th><th>Age</th><th>Height (cm)</th><th>Weight (kg)</th><th>Chest (cm)</th></tr></thead>
          <tbody>
            <tr><td>Newborn</td><td>0-1 month</td><td>50-56</td><td>3-4</td><td>33-36</td></tr>
            <tr><td>0-3M</td><td>0-3 months</td><td>56-62</td><td>4-6</td><td>36-40</td></tr>
            <tr><td>3-6M</td><td>3-6 months</td><td>62-68</td><td>6-8</td><td>40-43</td></tr>
            <tr><td>6-12M</td><td>6-12 months</td><td>68-80</td><td>8-10</td><td>43-47</td></tr>
            <tr><td>12-18M</td><td>12-18 months</td><td>80-86</td><td>10-12</td><td>47-50</td></tr>
            <tr><td>18-24M</td><td>18-24 months</td><td>86-92</td><td>12-13</td><td>50-52</td></tr>
            <tr><td>2-3Y</td><td>2-3 years</td><td>92-100</td><td>13-15</td><td>52-54</td></tr>
            <tr><td>3-4Y</td><td>3-4 years</td><td>100-108</td><td>15-17</td><td>54-57</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script type="application/json" id="product-variants-json">{{ product.variants | json }}</script>

{% schema %}
{
  "name": "Product Hero",
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Trust Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield",  "label": "Shield" },
            { "value": "leaf",    "label": "Leaf" },
            { "value": "truck",   "label": "Truck" },
            { "value": "refresh", "label": "Returns" },
            { "value": "heart",   "label": "Heart" },
            { "value": "star",    "label": "Star" },
            { "value": "check",   "label": "Check" },
            { "value": "lock",    "label": "Lock" },
            { "value": "smile",   "label": "Smile" },
            { "value": "custom",  "label": "Custom Image" }
          ],
          "default": "shield"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon Image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Badge Text",
          "default": "100% Organic Cotton"
        }
      ]
    },
    { "type": "@app" }
  ],
  "settings": [
    { "type": "header",   "content": "Buttons and Labels" },
    { "type": "text",     "id": "tax_note",          "label": "Tax Note (under price)",      "default": "Inclusive of all taxes" },
    { "type": "text",     "id": "add_to_cart_text",  "label": "Add to Cart Button",          "default": "Add to Basket" },
    { "type": "text",     "id": "sold_out_text",     "label": "Sold Out Button",             "default": "Sold Out" },
    { "type": "text",     "id": "quantity_label",    "label": "Qty Label",                   "default": "Qty" },
    { "type": "text",     "id": "bundle_label",      "label": "Bundle and Save Label",       "default": "Bundle and Save" },
    { "type": "text",     "id": "write_review_text", "label": "Write Review Link",           "default": "Write a review" },
    { "type": "text",     "id": "bxgy_note",         "label": "BXGY Note Text",              "default": "Applies to Bundle and Save products" },
    { "type": "header",   "content": "Gallery" },
    { "type": "paragraph","content": "Leave as Use global setting to follow the site-wide default set in Theme Settings. Override here for this product only." },
    {
      "type": "select",
      "id": "gallery_mode",
      "label": "Gallery Mode",
      "options": [
        { "value": "global",    "label": "Use global setting" },
        { "value": "slideshow", "label": "Slideshow" },
        { "value": "scroll",    "label": "Scroll Stack" },
        { "value": "grid",      "label": "Grid (H&M style)" }
      ],
      "default": "global"
    },
    { "type": "header",   "content": "Scroll Stack Settings" },
    { "type": "paragraph","content": "These settings apply when Gallery Mode is Scroll Stack." },
    {
      "type": "select",
      "id": "scroll_aspect",
      "label": "Image Aspect Ratio",
      "options": [
        { "value": "3/4",  "label": "3:4 Portrait" },
        { "value": "1/1",  "label": "1:1 Square" },
        { "value": "4/5",  "label": "4:5 Tall portrait" },
        { "value": "auto", "label": "Auto" }
      ],
      "default": "3/4"
    },
    { "type": "range",    "id": "scroll_gap",           "label": "Gap Between Images (px)", "min": 0, "max": 32, "step": 2, "default": 6 },
    { "type": "checkbox", "id": "scroll_sticky_thumbs", "label": "Keep thumbnails sticky while scrolling", "default": true },
    { "type": "header",   "content": "Badges" },
    { "type": "text",     "id": "new_badge_text",    "label": "New Arrival Badge Text",    "default": "New Arrival" },
    { "type": "header",   "content": "Size Guide" },
    { "type": "textarea", "id": "care_instructions", "label": "Care Instructions",         "default": "Machine wash cold. Gentle cycle. Do not bleach. Tumble dry low." },
    { "type": "textarea", "id": "shipping_info",     "label": "Shipping and Returns Info" },
    { "type": "header",   "content": "Trust Badges" },
    { "type": "range",    "id": "badge_size",        "label": "Icon Size (px)", "min": 12, "max": 28, "step": 2, "default": 16 },
    { "type": "header",   "content": "Social Sharing" },
    { "type": "paragraph","content": "Toggle each platform on or off." },
    { "type": "checkbox", "id": "share_whatsapp",  "label": "WhatsApp",   "default": true  },
    { "type": "checkbox", "id": "share_facebook",  "label": "Facebook",   "default": true  },
    { "type": "checkbox", "id": "share_twitter",   "label": "X / Twitter","default": true  },
    { "type": "checkbox", "id": "share_pinterest", "label": "Pinterest",  "default": true  },
    { "type": "checkbox", "id": "share_instagram", "label": "Instagram",  "default": false },
    { "type": "checkbox", "id": "share_tiktok",    "label": "TikTok",     "default": false },
    { "type": "checkbox", "id": "share_email",     "label": "Email",      "default": true  },
    { "type": "checkbox", "id": "share_copy_link", "label": "Copy Link",  "default": true  }
  ],
  "presets": [{
    "name": "Product Hero",
    "blocks": [
      { "type": "trust_badge", "settings": { "icon": "leaf",    "text": "100% Organic Cotton" } },
      { "type": "trust_badge", "settings": { "icon": "refresh", "text": "Free returns within 30 days" } },
      { "type": "trust_badge", "settings": { "icon": "truck",   "text": "Free shipping over Rs. 1500" } },
      { "type": "trust_badge", "settings": { "icon": "smile",   "text": "Skin-safe certified" } }
