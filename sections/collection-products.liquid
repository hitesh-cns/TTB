{% comment %}
  ============================================================
  SECTION: COLLECTION PRODUCTS
  ============================================================
  Collection page layout for /collections/* URLs.
  Horizontal sticky filter bar with collapsible filter panel.
  FILTERS: Products are filtered by tags in the format filter-{Group}:{Value}
    Example: tag 'filter-Color:Pink' creates a Pink option in the Colour filter.
    Add these tags in Shopify Admin → Products → each product → Tags field.
  EDIT: Theme Editor → Collection pages → Collection Products
  ============================================================
{% endcomment %}
{%- comment -%}
  -- Parse which filters are currently active from the URL
  -- e.g. ?filter-Color=White&filter-Size=0-3M
{%- endcomment -%}
{% assign active_filters = '' %}
{% for param in request.parameters %}
  {% if param[0] contains 'filter-' %}
    {% assign active_filters = active_filters | append: param[0] | append: ':' | append: param[1] | append: '|' %}
  {% endif %}
{% endfor %}

{%- comment -%}
  -- Build the list of filter groups from product tags.
  -- Only reads tags that start with "filter-"
{%- endcomment -%}
{% assign filter_groups_raw = '' %}
{% for product in collection.products %}
  {% for tag in product.tags %}
    {% if tag contains 'filter-' %}
      {% assign filter_groups_raw = filter_groups_raw | append: tag | append: '||' %}
    {% endif %}
  {% endfor %}
{% endfor %}

<!-- = COLLECTION HERO BANNER = -->
<div class="coll-hero"
  {% if collection.image %}
    style="background-image: linear-gradient(rgba(0,0,0,0.32), rgba(0,0,0,0.32)), url('{{ collection.image | img_url: '1600x' }}'); background-size: cover; background-position: center;"
  {% endif %}
>
  <h1 class="coll-hero__title">{{ collection.title }}</h1>
  {% if collection.description != blank %}
    <p class="coll-hero__desc">{{ collection.description | strip_html | truncate: 200 }}</p>
  {% endif %}
</div>

<!-- = STICKY FILTER BAR = -->
<div class="coll-filter-bar filter-wrapper" id="coll-filter-bar">
  <div class="container">
    <div class="coll-filter-bar__inner">

      <div class="coll-filter-bar__left">
        <div class="coll-filter-bar__controls">
          <button
            class="coll-filter-toggle"
            id="filter-toggle-mobile"
            aria-expanded="false"
            aria-controls="collection-sidebar"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="3" y1="6" x2="21" y2="6"/><line x1="7" y1="12" x2="17" y2="12"/><line x1="11" y1="18" x2="13" y2="18"/></svg>
            {{ section.settings.filters_label | default: "Filters" }}
            <span class="filter-count-badge" id="filter-count-badge" aria-live="polite"></span>
          </button>

          <span class="coll-filter-divider" aria-hidden="true"></span>

          <button class="coll-clear-all" id="sidebar-clear-all">{{ section.settings.clear_label | default: "Clear All" }}</button>
        </div>

        <div class="active-filter-chips" id="active-filter-chips" aria-label="Active filters" aria-live="polite"></div>
      </div>

      <div class="coll-filter-bar__right">
        <span class="coll-item-count">{{ collection.products_count }} {{ collection.products_count | pluralize: 'item', 'items' }}</span>
        <select class="collection-sort" id="collection-sort" aria-label="Sort products">
          <option value="manual"             {% if collection.sort_by == 'manual' %}selected{% endif %}>{{ section.settings.sort_featured | default: "Featured" }}</option>
          <option value="best-selling"       {% if collection.sort_by == 'best-selling' %}selected{% endif %}>Best Selling</option>
          <option value="created-descending" {% if collection.sort_by == 'created-descending' %}selected{% endif %}>{{ section.settings.sort_newest | default: "Newest" }}</option>
          <option value="price-ascending"    {% if collection.sort_by == 'price-ascending' %}selected{% endif %}>Price: Low to High</option>
          <option value="price-descending"   {% if collection.sort_by == 'price-descending' %}selected{% endif %}>Price: High to Low</option>
          <option value="title-ascending"    {% if collection.sort_by == 'title-ascending' %}selected{% endif %}>A–Z</option>
        </select>
      </div>

    </div>
  </div>

  <!-- = FILTER PANEL — inside filter bar so position:absolute top:100% floats over products = -->
  <div class="collection-sidebar" id="collection-sidebar" aria-label="Product filters">
    <div class="container">
      <div class="coll-filter-panel">

        <div class="filter-groups" id="filter-groups">
          <div class="filter-loading">
            <div class="filter-skeleton"></div>
            <div class="filter-skeleton"></div>
            <div class="filter-skeleton"></div>
          </div>
        </div>

        <button class="sidebar-close-btn" id="sidebar-close-btn" aria-label="Close filters">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>

      </div>
    </div>

    <!-- Hidden data element — passes product tags to JS -->
    <script type="application/json" id="collection-tags-data">
      {
        "tags": [
          {% assign all_tags = collection.all_tags %}
          {% for tag in all_tags %}
            {% if tag contains 'filter-' %}
              {{ tag | json }}{% unless forloop.last %},{% endunless %}
            {% endif %}
          {% endfor %}
        ],
        "activeUrl": {{ request.path | json }},
        "current_tags": {{ collection.current_tags | json }}
      }
    </script>
  </div>
</div>

<!-- = PRODUCT GRID = -->
<div class="container">
  {% paginate collection.products by section.settings.products_per_page %}

    {% if collection.products.size > 0 %}
      <div class="collection-grid" id="collection-grid" data-columns="{{ section.settings.grid_columns }}">
        {% for product in collection.products %}
          {% assign size_opt_idx = '' %}{% for _o in product.options %}{% if _o == 'Size' or _o == 'size' %}{% assign size_opt_idx = forloop.index0 %}{% endif %}{% endfor %}
          <div class="collection-product-card" data-tags="{{ product.tags | join: ',' | escape }}" data-variants='[{% for variant in product.variants %}{"id":{{ variant.id }},"title":"{{ variant.title | escape }}","options":{{ variant.options | json }},"available":{{ variant.available }}}{% unless forloop.last %},{% endunless %}{% endfor %}]'{% if size_opt_idx != '' %} data-size-option-index="{{ size_opt_idx }}"{% endif %}>

            <!-- Image area with badges, carousel, and add to cart -->
            <div class="cpc-image-wrap" data-images='[{% for img in product.images limit: 6 %}"{{ img | img_url: "600x" }}"{% unless forloop.last %},{% endunless %}{% endfor %}]'>
              <a href="{{ product.url }}" class="cpc-image-link" tabindex="0">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | img_url: '600x' }}"
                    alt="{{ product.featured_image.alt | default: product.title | escape }}"
                    class="cpc-img"
                    loading="{% if forloop.index <= 4 %}eager{% else %}lazy{% endif %}"
                    draggable="false"
                  >
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'cpc-img-placeholder' }}
                {% endif %}
              </a>

              <!-- Discount badge — top left -->
              {% assign disc_badge = product.metafields.custom.badge_text %}
              {% if disc_badge != blank %}
                <div class="cpc-badge cpc-badge--discount">{{ disc_badge }}</div>
              {% elsif product.compare_at_price > product.price %}
                {% assign disc_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
                <div class="cpc-badge cpc-badge--discount">{{ disc_pct }}% OFF</div>
              {% endif %}

              <!-- Label badge — bottom left -->
              {% if product.tags contains 'new' or product.tags contains 'New' %}
                <div class="cpc-badge cpc-badge--label">{{ section.settings.new_badge | default: "New" }}</div>
              {% elsif product.tags contains 'bestseller' or product.tags contains 'best-seller' %}
                <div class="cpc-badge cpc-badge--label">Bestseller</div>
              {% elsif product.tags contains 'restock' %}
                <div class="cpc-badge cpc-badge--label">Restock</div>
              {% endif %}

              <!-- Carousel arrows (multiple images only) -->
              {% if product.images.size > 1 %}
                <button class="cpc-arrow cpc-arrow--prev" aria-label="Previous image" tabindex="-1">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
                </button>
                <button class="cpc-arrow cpc-arrow--next" aria-label="Next image" tabindex="-1">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                </button>
                <div class="cpc-dots-container" aria-hidden="true"></div>
              {% endif %}

              <!-- Add to Cart — full-width pill at bottom, visible on hover -->
              <button
                class="cpc-add-btn"
                data-variant-id="{{ product.variants.first.id }}"
                {% if product.variants.size > 1 %}data-has-variants="true"{% endif %}
                aria-label="Add {{ product.title | escape }} to cart"
              >Add to Cart</button>


            </div>

            <!-- Product info below image -->
            <div class="cpc-info">

              <h3 class="cpc-title">
                <a href="{{ product.url }}">{{ product.title }}</a>
              </h3>

              <div class="cpc-price-row">
                {% if product.compare_at_price > product.price %}
                  <span class="cpc-price cpc-price--compare">{{ product.compare_at_price | money }}</span>
                  <span class="cpc-price cpc-price--sale">{{ product.price | money }}</span>
                {% else %}
                  <span class="cpc-price">{{ product.price | money }}</span>
                {% endif %}
              </div>

              <!-- Colour swatches -->
              {% assign color_option_index = nil %}
              {% for option in product.options %}
                {% if option == 'Color' or option == 'Colour' %}
                  {% assign color_option_index = forloop.index0 %}
                {% endif %}
              {% endfor %}

              {% if color_option_index != nil %}
                <div class="cpc-color-row" data-option-index="{{ color_option_index }}">
                  {% assign shown_colors = '' %}
                  {% for variant in product.variants %}
                    {% assign color_val = variant.options[color_option_index] %}
                    {% unless shown_colors contains color_val %}
                      {% assign shown_colors = shown_colors | append: color_val | append: ',' %}
                      <button
                        class="cpc-color-swatch{% if forloop.first %} is-selected{% endif %}"
                        data-variant-id="{{ variant.id }}"
                        data-color="{{ color_val | escape }}"
                        data-image="{% if variant.featured_image %}{{ variant.featured_image | img_url: '600x' }}{% endif %}"
                        style="background-color: {{ color_val | downcase | replace: ' ', '' }};"
                        title="{{ color_val }}"
                        aria-label="Select {{ color_val }}"
                        aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                      ></button>
                    {% endunless %}
                  {% endfor %}
                </div>
              {% endif %}

            </div>
          </div>
        {% endfor %}
      </div>

      <!-- No results message (hidden by default, shown by JS when filters match nothing) -->
      <div class="collection-no-results" id="collection-no-results" style="display:none;">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <h3>No products match your filters</h3>
        <p>Try removing a filter or <button class="link-btn" id="no-results-clear">clear all filters</button> to see all products.</p>
      </div>

      <!-- Pagination -->
      {% if paginate.pages > 1 %}
        <nav class="pagination" aria-label="Product pages">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}" class="pagination-btn" aria-label="Previous page">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="15 18 9 12 15 6"/></svg>
            </a>
          {% endif %}
          {% for part in paginate.parts %}
            {% if part.is_link %}
              <a href="{{ part.url }}" class="pagination-num">{{ part.title }}</a>
            {% elsif part.title == paginate.current_page %}
              <span class="pagination-num is-active" aria-current="page">{{ part.title }}</span>
            {% else %}
              <span class="pagination-ellipsis">…</span>
            {% endif %}
          {% endfor %}
          {% if paginate.next %}
            <a href="{{ paginate.next.url }}" class="pagination-btn" aria-label="Next page">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="9 18 15 12 9 6"/></svg>
            </a>
          {% endif %}
        </nav>
      {% endif %}

    {% else %}
      <!-- Empty collection state -->
      <div class="collection-empty">
        <p>No products found in this collection.</p>
        <a href="/collections/all" class="btn btn--outline">Browse All Products</a>
      </div>
    {% endif %}

  {% endpaginate %}
</div>

<!-- = GLOBAL SIZE SHEET = -->
<div id="size-sheet-backdrop" class="size-sheet-backdrop" aria-hidden="true"></div>
<div id="size-sheet" class="size-sheet" aria-hidden="true" role="dialog" aria-label="Select size" aria-modal="true">
  <div class="size-sheet__handle" aria-hidden="true"></div>
  <div class="size-sheet__header">
    <p class="size-sheet__product-name" id="size-sheet-name"></p>
    <p class="size-sheet__color" id="size-sheet-color"></p>
  </div>
  <p class="size-sheet__label">Select Size</p>
  <div class="size-sheet__grid" id="size-sheet-grid"></div>
  <button class="size-sheet__confirm" id="size-sheet-confirm" disabled>Add to Cart</button>
</div>

<script>
(function() {
  var swatchUrl = {{ 'swatches.json' | asset_url | json }};
  fetch(swatchUrl)
    .then(function(r) { return r.json(); })
    .then(function(data) {
      window.swatchConfig = {};
      (data.swatches || []).forEach(function(s) {
        window.swatchConfig[s.name] = { hex: s.hex, border: s.border, label: s.label };
      });
      document.querySelectorAll('[data-color]').forEach(function(el) {
        var name = (el.dataset.color || '').toLowerCase().replace(/\s+/g, '-');
        var cfg = window.swatchConfig[name];
        if (cfg) {
          el.style.backgroundColor = cfg.hex;
          el.style.borderColor = cfg.border;
          el.title = cfg.label;
        }
      });
      initCardImages();
    })
    .catch(function() { initCardImages(); });

  function normColor(str) {
    return str.toLowerCase().replace(/[-_\s]+/g, '');
  }

  function initCardImages() {
    document.querySelectorAll('.collection-product-card').forEach(function(card) {
      var wrap = card.querySelector('.cpc-image-wrap');
      if (!wrap || !wrap._carousel) return;
      var activeSwatch = card.querySelector('.cpc-color-swatch.is-selected');
      if (!activeSwatch) return;
      var colorNorm = normColor(activeSwatch.dataset.color || '');
      if (!colorNorm) return;
      var all = wrap._carousel.defaultImages;
      var filtered = all.filter(function(u) { return normColor(u).includes(colorNorm); });
      if (filtered.length) {
        wrap._carousel.setImages(filtered);
      }
    });
  }
})();
</script>

{% schema %}
{
  "name": "Collection Products",
  "settings": [
    { "type": "text", "id": "filters_label", "label": "Filters Label", "default": "Filters" },
    { "type": "text", "id": "clear_label",   "label": "Clear Label",   "default": "Clear all" },
    { "type": "text", "id": "sort_featured", "label": "Sort Featured", "default": "Featured" },
    { "type": "header", "content": "Labels" },
    { "type": "text", "id": "new_badge",   "label": "'New' Badge Text",   "default": "New" },
    { "type": "text", "id": "sort_newest", "label": "Sort: Newest Label", "default": "Newest" },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products Per Page",
      "info": "How many products to show before pagination kicks in.",
      "min": 12,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "select",
      "id": "grid_columns",
      "label": "Grid Columns (Desktop)",
      "info": "How many product columns to show side-by-side on desktop.",
      "options": [
        { "value": "2", "label": "2 columns" },
        { "value": "3", "label": "3 columns" },
        { "value": "4", "label": "4 columns" }
      ],
      "default": "4"
    },
    {
      "type": "header",
      "content": "Filters",
      "info": "Filters are built automatically from product tags. Add tags in the format 'filter-Color:White' to a product to add it to the Color filter group with a White option."
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show filter bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count next to filter values",
      "default": true
    }
  ],
  "presets": [
    { "name": "Collection Products" }
  ]
}
{% endschema %}
