<div class="password-page">
  <div class="password-page__inner">
    <div class="password-page__logo">
      {%- if settings.logo -%}
        {{ settings.logo | image_url: width: 200 | image_tag: alt: shop.name }}
      {%- else -%}
        <span class="password-page__shop-name">{{ shop.name }}</span>
      {%- endif -%}
    </div>

    {%- if shop.password_message != blank -%}
      <p class="password-page__message">{{ shop.password_message }}</p>
    {%- endif -%}

    <h1 class="password-page__title">{{ 'password.title' | t }}</h1>
    <p class="password-page__sub">{{ 'password.subtext' | t }}</p>

    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
        <p class="password-page__error">{{ 'password.error' | t }}</p>
      {%- endif -%}
      <div class="password-page__form">
        <label for="password" class="visually-hidden">{{ 'password.label' | t }}</label>
        <input
          type="password"
          id="password"
          name="password"
          class="password-page__input"
          placeholder="{{ 'password.label' | t }}"
          autocomplete="current-password"
        >
        <button type="submit" class="btn btn--primary">{{ 'password.submit' | t }}</button>
      </div>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": []
}
{% endschema %}

<style>
.password-page { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 40px 24px; text-align: center; }
.password-page__inner { max-width: 440px; width: 100%; }
.password-page__logo { margin-bottom: 32px; }
.password-page__shop-name { font-family: var(--font-display); font-size: 2rem; }
.password-page__title { font-family: var(--font-display); font-size: clamp(1.5rem,4vw,2.5rem); margin-bottom: 12px; }
.password-page__sub { color: #666; margin-bottom: 32px; }
.password-page__message { color: #444; margin-bottom: 24px; }
.password-page__error { color: #c0392b; margin-bottom: 12px; }
.password-page__form { display: flex; gap: 10px; }
.password-page__input { flex: 1; padding: 12px 16px; border: 1px solid #ddd; font-family: var(--font-body); font-size: 1rem; border-radius: 4px; }
</style>
