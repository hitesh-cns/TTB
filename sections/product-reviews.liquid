{% comment %}
  ============================================================
  SECTION: PRODUCT REVIEWS
  ============================================================
  Product Reviews — Shows on every product page below the product hero.
  Customers can submit reviews with photos directly from the product page.
  Reviews are stored in Shopify's native review system (or can be connected
  to an app like Judge.me by replacing this section).
  EDIT: Theme Editor → Product pages → Product Reviews
  ============================================================
{% endcomment %}
<section class="reviews-section section-spacing" id="reviews-section">
  <div class="container">

    <div class="section-header">
      <p class="section-eyebrow">{{ section.settings.eyebrow | default: 'Customer Reviews' }}</p>
      <h2 class="section-heading">{{ section.settings.heading | default: 'What Parents Are Saying' }}</h2>
    </div>

    <div class="reviews-layout">

      <!-- Left: Rating Summary -->
      <div class="reviews-summary">
        <div class="reviews-summary__score">
          <span class="score-big" id="avg-score">4.8</span>
          <span class="score-label">out of 5</span>
        </div>

        <div class="stars-display stars-display--lg" id="summary-stars">
          {% for i in (1..5) %}<span class="star star--filled">★</span>{% endfor %}
        </div>

        <p class="reviews-total-count" id="total-reviews-count">Based on 0 reviews</p>

        <!-- Rating breakdown bars -->
        <div class="rating-breakdown" id="rating-breakdown">
          {% for i in (5..1) reversed %}
            <div class="breakdown-row" data-stars="{{ i }}">
              <div class="breakdown-stars">
                {% for j in (1..i) %}★{% endfor %}
              </div>
              <div class="breakdown-bar">
                <div class="breakdown-fill" data-stars="{{ i }}" style="width:0%"></div>
              </div>
              <span class="breakdown-count" data-stars="{{ i }}">0</span>
            </div>
          {% endfor %}
        </div>

        <!-- Write review trigger -->
        <button class="btn btn--outline btn--full review-trigger" id="write-review-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          Write a Review
        </button>
      </div>

      <!-- Right: Reviews list -->
      <div class="reviews-list-col">

        <!-- Filter bar -->
        <div class="reviews-filter-bar">
          <div class="reviews-filter-tabs" id="filter-tabs">
            <button class="filter-tab is-active" data-filter="all">All</button>
            <button class="filter-tab" data-filter="5">5 ★</button>
            <button class="filter-tab" data-filter="4">4 ★</button>
            <button class="filter-tab" data-filter="3">3 ★</button>
          </div>
          <select class="reviews-sort" id="reviews-sort">
            <option value="newest">Newest First</option>
            <option value="highest">Highest Rated</option>
            <option value="lowest">Lowest Rated</option>
            <option value="helpful">Most Helpful</option>
          </select>
        </div>

        <!-- Reviews container -->
        <div class="reviews-list" id="reviews-list">
          <!-- Sample seed reviews (shown when no metafield reviews exist) -->
          {% for block in section.blocks %}
            {% if block.type == 'review' %}
            <article class="review-card" data-stars="{{ block.settings.rating }}" {{ block.shopify_attributes }}>
              <div class="review-card__header">
                <div class="review-card__author-avatar">
                  {% if block.settings.avatar != blank %}
                    <img src="{{ block.settings.avatar | img_url: '80x80', crop: 'center' }}" alt="{{ block.settings.author }}">
                  {% else %}
                    <span>{{ block.settings.author | slice: 0, 1 | upcase }}</span>
                  {% endif %}
                </div>
                <div class="review-card__author-info">
                  <p class="review-card__author-name">{{ block.settings.author }}</p>
                  <p class="review-card__author-meta">
                    {% if block.settings.verified %}<span class="verified-badge">✓ Verified Purchase</span>{% endif %}
                    <span class="review-date">{{ block.settings.date | default: 'Recently' }}</span>
                  </p>
                </div>
                <div class="review-card__stars">
                  {% assign stars = block.settings.rating | default: 5 %}
                  {% for i in (1..5) %}
                    <span class="star {% if i <= stars %}star--filled{% endif %}">★</span>
                  {% endfor %}
                </div>
              </div>

              {% if block.settings.title != blank %}
                <h4 class="review-card__title">{{ block.settings.title }}</h4>
              {% endif %}

              <p class="review-card__body">{{ block.settings.body }}</p>

              {% if block.settings.photo != blank or block.settings.photo_2 != blank or block.settings.photo_3 != blank %}
                <div class="review-images">
                  {% if block.settings.photo != blank %}
                    <div class="review-image-thumb">
                      <img src="{{ block.settings.photo | img_url: '300x300', crop: 'center' }}" alt="Review photo" loading="lazy">
                    </div>
                  {% endif %}
                  {% if block.settings.photo_2 != blank %}
                    <div class="review-image-thumb">
                      <img src="{{ block.settings.photo_2 | img_url: '300x300', crop: 'center' }}" alt="Review photo" loading="lazy">
                    </div>
                  {% endif %}
                  {% if block.settings.photo_3 != blank %}
                    <div class="review-image-thumb">
                      <img src="{{ block.settings.photo_3 | img_url: '300x300', crop: 'center' }}" alt="Review photo" loading="lazy">
                    </div>
                  {% endif %}
                </div>
              {% endif %}

              <div class="review-card__footer">
                <button class="helpful-btn" data-id="{{ block.id }}">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"/></svg>
                  Helpful ({{ block.settings.helpful_count | default: 0 }})
                </button>
              </div>
            </article>
            {% endif %}
          {% endfor %}

          {% comment %} App-block slot (e.g. Judge.me review widget). Empty and inert until an app block is added in the Theme Editor. {% endcomment %}
          {% for block in section.blocks %}
            {% if block.type == '@app' %}{% render block %}{% endif %}
          {% endfor %}

          <div class="reviews-empty" id="reviews-empty" style="display:none;">
            <div class="reviews-empty__icon">💬</div>
            <p>{{ section.settings.empty_text | default: "No reviews yet. Be the first to share your experience!" }}</p>
          </div>
        </div>

        <!-- Load more -->
        <div class="reviews-load-more" id="reviews-load-more" style="display:none;">
          <button class="btn btn--ghost" id="load-more-btn">{{ section.settings.load_more_btn | default: "Load More Reviews" }}</button>
        </div>
      </div>
    </div>

    <!-- Write Review Form -->
    <div class="review-form-wrap" id="review-form-wrap" aria-hidden="true">
      <div class="review-form-inner">
        <div class="review-form-header">
          <h3 class="review-form-title">{{ section.settings.write_heading | default: "Share Your Experience" }}</h3>
          <button class="review-form-close" id="review-form-close" aria-label="Close">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>

        <form class="review-form" id="review-form">
          <!-- Star selector -->
          <div class="form-group">
            <label class="form-label">Your Rating <span class="required">*</span></label>
            <div class="star-picker" id="star-picker" role="radiogroup" aria-label="Rating">
              {% for i in (1..5) %}
                <button type="button" class="star-pick" data-value="{{ i }}" aria-label="{{ i }} stars">★</button>
              {% endfor %}
            </div>
            <input type="hidden" name="rating" id="review-rating" required>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="review-name">Your Name <span class="required">*</span></label>
              <input type="text" id="review-name" name="name" class="form-input" placeholder="Sophie M." required>
            </div>
            <div class="form-group">
              <label class="form-label" for="review-email">Email <span class="required">*</span></label>
              <input type="email" id="review-email" name="email" class="form-input" placeholder="you@email.com" required>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="review-title">Review Title</label>
            <input type="text" id="review-title" name="title" class="form-input" placeholder="Summarise your experience">
          </div>

          <div class="form-group">
            <label class="form-label" for="review-body">Your Review <span class="required">*</span></label>
            <textarea id="review-body" name="body" class="form-textarea" rows="5" placeholder="Tell other parents what you love about this product..." required></textarea>
          </div>

          <div class="form-group">
            <label class="form-label">Size Fit</label>
            <div class="fit-selector">
              <button type="button" class="fit-btn" data-value="runs-small">Runs Small</button>
              <button type="button" class="fit-btn" data-value="true-to-size">True to Size</button>
              <button type="button" class="fit-btn" data-value="runs-large">Runs Large</button>
            </div>
            <input type="hidden" name="fit" id="review-fit">
          </div>

          <div class="form-group">
            <label class="form-label" for="review-photo">{{ section.settings.photo_label | default: "Add a Photo (optional)" }}</label>
            <div class="photo-upload-area" id="photo-upload-area">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              <span>Click to upload or drag & drop</span>
              <input type="file" id="review-photo" name="photo" accept="image/*" class="photo-input">
            </div>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn--primary">{{ section.settings.submit_btn | default: "Submit Review" }}</button>
            <button type="button" class="btn btn--ghost" id="cancel-review">{{ section.settings.cancel_btn | default: "Cancel" }}</button>
          </div>
        </form>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Product Reviews",
  "max_blocks": 50,
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text",         "id": "author",        "label": "Author Name",      "default": "Happy Parent" },
        { "type": "range",        "id": "rating",        "label": "Star Rating",  "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text",         "id": "title",         "label": "Review Title",     "default": "Absolutely gorgeous quality" },
        { "type": "textarea",     "id": "body",          "label": "Review Body",      "default": "The fabric is unbelievably soft and the fit is perfect. My little one wears this constantly." },
        { "type": "image_picker", "id": "avatar",        "label": "Author Avatar" },
        { "type": "image_picker", "id": "photo",         "label": "Review Photo 1" },
        { "type": "image_picker", "id": "photo_2",       "label": "Review Photo 2" },
        { "type": "image_picker", "id": "photo_3",       "label": "Review Photo 3" },
        { "type": "text",         "id": "date",          "label": "Date",             "default": "2 weeks ago" },
        { "type": "checkbox",     "id": "verified",      "label": "Verified Purchase","default": true },
        { "type": "number",       "id": "helpful_count", "label": "Helpful Count",    "default": 0 }
      ]
    },
    { "type": "@app" }
  ],
  "settings": [
    { "type": "header",   "content": "Section Heading" },
    { "type": "text",     "id": "eyebrow",        "label": "Eyebrow",               "default": "Customer Reviews" },
    { "type": "text",     "id": "heading",        "label": "Heading",               "default": "What Parents Are Saying" },
    { "type": "header",   "content": "Labels & Buttons" },
    { "type": "text",     "id": "write_heading",  "label": "Write Review Heading",  "default": "Share Your Experience" },
    { "type": "text",     "id": "submit_btn",     "label": "Submit Button",          "default": "Submit Review" },
    { "type": "text",     "id": "cancel_btn",     "label": "Cancel Button",          "default": "Cancel" },
    { "type": "text",     "id": "load_more_btn",  "label": "Load More Button",       "default": "Load More Reviews" },
    { "type": "text",     "id": "empty_text",     "label": "No Reviews Message",     "default": "No reviews yet. Be the first to share your experience!" },
    { "type": "text",     "id": "photo_label",    "label": "Photo Upload Label",     "default": "Add a Photo (optional)" },
    { "type": "text",     "id": "verified_label", "label": "Verified Badge Label",   "default": "Verified Purchase" },
    { "type": "header",   "content": "Display" },
    { "type": "range",    "id": "reviews_per_page","label": "Reviews per page",
      "min": 3, "max": 20, "step": 1, "default": 6 },
    { "type": "checkbox", "id": "show_photos",    "label": "Show Review Photos",     "default": true },
    { "type": "checkbox", "id": "show_helpful",   "label": "Show Helpful Votes",     "default": true }
  ],
  "presets": [{
    "name": "Product Reviews",
    "blocks": [
      { "type": "review" },
      { "type": "review" },
      { "type": "review" }
    ]
  }]
}
{% endschema %}
