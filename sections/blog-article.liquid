{% comment %}
  ============================================================
  SECTION: BLOG ARTICLE
  ============================================================
  Blog Article — Individual article pages (/blogs/*/article-handle).
  Contains: hero image, article body, author, tags, comment form, related articles.
  EDIT: Theme Editor → Blog pages → Blog Article
  ============================================================
{% endcomment %}
<div class="be-page">

  <!-- Article hero -->
  <div class="article-hero">
    {% if article.image %}
      <img src="{{ article.image | img_url: '1600x' }}" alt="{{ article.image.alt | default: article.title | escape }}"
           class="article-hero__img" loading="eager">
      <div class="article-hero__overlay"></div>
    {% endif %}
    <div class="container article-hero__content {% unless article.image %}article-hero__content--no-img{% endunless %}">
      <nav class="product-breadcrumb article-breadcrumb">
        <a href="/blogs/{{ blog.handle }}">{{ section.settings.breadcrumb_label | default: "Journal" }}</a>
        <span>›</span>
        <span>{{ article.title | truncate: 40 }}</span>
      </nav>
      {% for tag in article.tags limit: 2 %}
        <span class="blog-tag-pill {% if article.image %}blog-tag-pill--light{% endif %}">{{ tag }}</span>
      {% endfor %}
      <h1 class="article-hero__title">{{ article.title }}</h1>
      <div class="article-hero__meta">
        <div class="blog-author-avatar">{{ article.author | slice: 0 }}</div>
        <span>{{ article.author }}</span>
        <span>·</span>
        <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%d %B %Y' }}</time>
        <span>·</span>
        <span>{{ article.content | strip_html | split: ' ' | size | divided_by: 200 | plus: 1 }} min read</span>
      </div>
    </div>
  </div>

  <!-- Article body -->
  <div class="container">
    <div class="article-layout">

      <!-- Main content -->
      <div class="article-body">

        <!-- Excerpt / lede -->
        {% if article.excerpt != blank %}
          <p class="article-lede">{{ article.excerpt | strip_html }}</p>
        {% endif %}

        <!-- Full content -->
        <div class="rte article-content">{{ article.content }}</div>

        <!-- Tags -->
        {% if section.settings.show_tags != false and article.tags.size > 0 %}
          <div class="article-tags">
            <span class="article-tags__label">{{ section.settings.tags_label | default: "Topics:" }}</span>
            {% for tag in article.tags %}
              <a href="{{ blog.url }}/tagged/{{ tag | handleize }}" class="blog-tag-pill">{{ tag }}</a>
            {% endfor %}
          </div>
        {% endif %}

        <!-- Share -->
        <div class="article-share">
          <span class="article-share__label">Share this article</span>
          <div class="article-share__links">
            <a href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url }}{{ article.url | url_encode }}"
               target="_blank" rel="noopener" class="article-share__btn" aria-label="Share on Facebook">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
              Facebook
            </a>
            <a href="https://twitter.com/intent/tweet?text={{ article.title | url_encode }}&url={{ shop.url }}{{ article.url | url_encode }}"
               target="_blank" rel="noopener" class="article-share__btn" aria-label="Share on X">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              X
            </a>
            <a href="https://wa.me/?text={{ article.title | url_encode }}%20{{ shop.url }}{{ article.url | url_encode }}"
               target="_blank" rel="noopener" class="article-share__btn" aria-label="Share on WhatsApp">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
              WhatsApp
            </a>
          </div>
        </div>

        <!-- Article navigation -->
        <div class="article-nav">
          {% if blog.previous_article %}
            <a href="{{ blog.previous_article }}" class="article-nav__link article-nav__link--prev">
              <span class="article-nav__dir">← Previous</span>
              <span class="article-nav__title">{{ blog.previous_article.title | truncate: 50 }}</span>
            </a>
          {% else %}<div></div>{% endif %}
          {% if blog.next_article %}
            <a href="{{ blog.next_article }}" class="article-nav__link article-nav__link--next">
              <span class="article-nav__dir">Next →</span>
              <span class="article-nav__title">{{ blog.next_article.title | truncate: 50 }}</span>
            </a>
          {% endif %}
        </div>

        <!-- Comments -->
        {% if blog.comments_enabled? %}
          <div class="article-comments" id="comments">
            <h2 class="article-comments__title">
              {{ article.comments_count }} Comment{{ article.comments_count | pluralize: '', 's' }}
            </h2>

            {% for comment in article.comments %}
              <div class="comment">
                <div class="comment__avatar">{{ comment.author | slice: 0 }}</div>
                <div class="comment__body">
                  <div class="comment__header">
                    <span class="comment__author">{{ comment.author }}</span>
                    <time class="comment__date">{{ comment.created_at | date: '%d %B %Y' }}</time>
                  </div>
                  <p class="comment__text">{{ comment.content }}</p>
                </div>
              </div>
            {% endfor %}

            <!-- Comment form -->
            {% form 'new_comment', article, class: 'comment-form' %}
              <h3 class="comment-form__title">Leave a Comment</h3>
              {% if form.posted_successfully? %}
                <div class="contact-success">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                  <p>Comment submitted{% if blog.moderated? %} — it will appear after approval{% endif %}. Thank you!</p>
                </div>
              {% endif %}
              {% if form.errors %}
                <div class="auth-error">{{ form.errors | default_errors }}</div>
              {% endif %}
              <div class="auth-row">
                <div class="auth-field">
                  <label class="auth-label" for="comment-author">Name *</label>
                  <input class="auth-input" type="text" name="comment[author]" id="comment-author" required>
                </div>
                <div class="auth-field">
                  <label class="auth-label" for="comment-email">Email *</label>
                  <input class="auth-input" type="email" name="comment[email]" id="comment-email" required>
                </div>
              </div>
              <div class="auth-field">
                <label class="auth-label" for="comment-body">Comment *</label>
                <textarea class="auth-input auth-textarea" name="comment[body]" id="comment-body" rows="4" required></textarea>
              </div>
              <button type="submit" class="btn btn--primary">Post Comment</button>
            {% endform %}
          </div>
        {% endif %}

      </div><!-- /article-body -->

      <!-- Sidebar -->
      <aside class="article-sidebar">

        <!-- Author card -->
        <div class="article-sidebar-card">
          <div class="article-author-avatar">{{ article.author | slice: 0 }}</div>
          <h3 class="article-sidebar-card__title">{{ article.author }}</h3>
          <p class="article-sidebar-card__sub">Baby Elegance Editorial Team</p>
        </div>

        <!-- Related articles -->
        {% assign related_count = 0 %}
        {% for a in blog.articles %}
          {% unless a.id == article.id %}
            {% if related_count < 3 %}
              {% assign related_count = related_count | plus: 1 %}
              {% if related_count == 1 %}
                <div class="article-sidebar-card">
                  <h3 class="article-sidebar-card__title" style="margin-bottom:12px;">More from the Journal</h3>
              {% endif %}
              <a href="{{ a.url }}" class="article-related">
                {% if a.image %}
                  <img src="{{ a.image | img_url: '200x' }}" alt="{{ a.title | escape }}" class="article-related__img" loading="lazy">
                {% endif %}
                <div>
                  <p class="article-related__title">{{ a.title | truncate: 55 }}</p>
                  <p class="article-related__date">{{ a.published_at | date: '%d %b %Y' }}</p>
                </div>
              </a>
            {% endif %}
          {% endunless %}
        {% endfor %}
        {% if related_count > 0 %}
          <a href="/blogs/{{ blog.handle }}" class="article-sidebar-all">← All articles</a>
          </div>
        {% endif %}

        <!-- Newsletter -->
        <div class="article-sidebar-card article-sidebar-card--newsletter">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          <h3 class="article-sidebar-card__title">Join Our Newsletter</h3>
          <p>Get care guides and exclusive offers delivered to your inbox.</p>
          {% form 'customer', class: 'article-newsletter-form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <input class="auth-input" type="email" name="contact[email]" placeholder="your@email.com" required>
            <button type="submit" class="btn btn--primary btn--full" style="margin-top:8px;">Subscribe</button>
            {% if form.posted_successfully? %}
              <p class="auth-success">✓ Subscribed! Welcome to the family.</p>
            {% endif %}
          {% endform %}
        </div>

        {% comment %} App-block slot. Empty and inert until an app block is added in the Theme Editor. {% endcomment %}
        {% for block in section.blocks %}
          {% if block.type == '@app' %}{% render block %}{% endif %}
        {% endfor %}

      </aside>

    </div><!-- /article-layout -->
  </div>

</div>

{% schema %}
{
  "name": "Blog Article",
  "blocks": [
    { "type": "@app" }
  ],
  "settings": [
    { "type": "header",   "content": "Labels" },
    { "type": "text",     "id": "breadcrumb_label", "label": "Breadcrumb Label",
      "default": "Journal", "info": "The clickable link in the breadcrumb e.g. 'Blog' or 'Journal'." },
    { "type": "text",     "id": "tags_label",       "label": "Tags Label",
      "default": "Topics:" },
    { "type": "text",     "id": "related_heading",  "label": "Related Articles Heading",
      "default": "More from the Journal" },
    { "type": "text",     "id": "comment_heading",  "label": "Comments Section Heading",
      "default": "Leave a Comment" },
    { "type": "text",     "id": "comment_btn",      "label": "Post Comment Button",
      "default": "Post Comment" },
    { "type": "header",   "content": "Display Options" },
    { "type": "checkbox", "id": "show_author",   "label": "Show Author Name",       "default": true },
    { "type": "checkbox", "id": "show_date",     "label": "Show Publication Date",  "default": true },
    { "type": "checkbox", "id": "show_read_time","label": "Show Estimated Read Time","default": true },
    { "type": "checkbox", "id": "show_tags",     "label": "Show Article Tags",       "default": true },
    { "type": "checkbox", "id": "show_share",    "label": "Show Social Share Buttons","default": true },
    { "type": "checkbox", "id": "show_related",  "label": "Show Related Articles",   "default": true },
    { "type": "checkbox", "id": "show_comments", "label": "Show Comments Section",   "default": true },
    { "type": "range",    "id": "related_count", "label": "Number of Related Articles",
      "min": 2, "max": 6, "step": 1, "default": 3 }
  ],
  "presets": [
    { "name": "Blog Article" }
  ]
}
{% endschema %}