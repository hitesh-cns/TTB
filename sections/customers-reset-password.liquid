{% comment %}
  ============================================================
  SECTION: CUSTOMERS RESET PASSWORD
  ============================================================
  Customer Reset Password — The /account/reset/* page.
  Shown after a customer clicks the reset link from their email.
  EDIT: Theme Editor → Customer pages → Reset Password
  ============================================================
{% endcomment %}
<div class="auth-page">
  <div class="auth-card">

    <div class="auth-brand">
      <p class="section-eyebrow">Account Recovery</p>
      <h1 class="auth-heading">Reset Password</h1>
      <p class="auth-sub">Choose a new password for your account.</p>
    </div>

    {% form 'reset_customer_password', class: 'auth-form' %}
      {% if form.errors %}
        <div class="auth-error" role="alert">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}

      <div class="auth-field">
        <label class="auth-label" for="reset-password">New Password</label>
        <div class="auth-input-wrap">
          <input class="auth-input" type="password" name="customer[password]" id="reset-password"
                 autocomplete="new-password" minlength="5" required placeholder="Min 5 characters">
          <button type="button" class="auth-eye" id="reset-eye" aria-label="Toggle">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
      </div>

      <div class="auth-field">
        <label class="auth-label" for="reset-confirm">Confirm New Password</label>
        <input class="auth-input" type="password" name="customer[password_confirmation]" id="reset-confirm"
               autocomplete="new-password" minlength="5" required placeholder="Repeat your password">
      </div>

      <button type="submit" class="btn btn--primary btn--full">Set New Password</button>
    {% endform %}

  </div>
</div>

<script>
const eye = document.getElementById('reset-eye');
const pwd = document.getElementById('reset-password');
eye && eye.addEventListener('click', () => { pwd.type = pwd.type === 'password' ? 'text' : 'password'; });
</script>

{% schema %}{ "name": "Reset Password", "settings": [], "presets": [{ "name": "Reset Password" }] }{% endschema %}
