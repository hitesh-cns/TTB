{% comment %}
  ============================================================
  SECTION: CUSTOMERS LOGIN
  ============================================================
  Sign In page — /account/login
  Two panels side by side on desktop: decorative brand panel
  on the left, sign-in form on the right.
  Includes inline password recovery (no page reload needed).
  EDIT: Theme Editor → Customer pages → Customer Login
  ============================================================
{% endcomment %}

<div class="auth-split-page">

  <!-- Left: decorative brand panel -->
  <div class="auth-split-panel">
    {% if section.settings.panel_image != blank %}
      <img src="{{ section.settings.panel_image | img_url: '900x' }}"
           alt="{{ shop.name }}"
           class="auth-split-panel__img">
      <div class="auth-split-panel__overlay"></div>
    {% else %}
      <div class="auth-split-panel__gradient"></div>
    {% endif %}

    <div class="auth-split-panel__content">
      <a href="{{ routes.root_url }}" class="auth-split-panel__logo">
        {% if section.settings.panel_logo != blank %}
          <img src="{{ section.settings.panel_logo | img_url: '300x' }}"
               alt="{{ shop.name }}" class="auth-split-panel__logo-img">
        {% else %}
          <span class="auth-split-panel__logo-text">{{ shop.name }}</span>
        {% endif %}
      </a>

      <div class="auth-split-panel__tagline">
        <h2 class="auth-split-panel__heading">
          {{ section.settings.panel_heading | default: 'Welcome back' }}
        </h2>
        <p class="auth-split-panel__sub">
          {{ section.settings.panel_sub | default: 'Sign in to access your orders, saved addresses and exclusive member offers.' }}
        </p>
      </div>

      <div class="auth-split-panel__dots">
        <span></span><span></span><span></span>
      </div>
    </div>
  </div>

  <!-- Right: form panel -->
  <div class="auth-split-form">
    <div class="auth-split-form__inner">

      <!-- Sign In form -->
      <div id="auth-login-form">
        <div class="auth-brand">
          <p class="section-eyebrow">{{ section.settings.eyebrow | default: 'My Account' }}</p>
          <h1 class="auth-heading">{{ section.settings.heading | default: 'Sign In' }}</h1>
          <p class="auth-sub">{{ section.settings.sub | default: "Don't have an account?" }}
            <a href="{{ routes.account_register_url }}" class="auth-inline-link">
              {{ section.settings.register_link | default: 'Create one' }}
            </a>
          </p>
        </div>

        {% form 'customer_login', class: 'auth-form' %}
          {% if form.errors %}
            <div class="auth-error" role="alert">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              <div>{{ form.errors | default_errors }}</div>
            </div>
          {% endif %}

          <div class="auth-field">
            <label class="auth-label" for="login-email">Email Address</label>
            <input class="auth-input" type="email" name="customer[email]" id="login-email"
                   autocomplete="email" autocapitalize="off" spellcheck="false"
                   required placeholder="you@email.com">
          </div>

          <div class="auth-field">
            <label class="auth-label" for="login-password">
              Password
              <button type="button" class="auth-label__link" id="forgot-password-btn"
                      onclick="document.getElementById('auth-login-form').style.display='none';document.getElementById('auth-recover-form').style.display='block';">
                Forgot password?
              </button>
            </label>
            <div class="auth-input-wrap">
              <input class="auth-input" type="password" name="customer[password]" id="login-password"
                     autocomplete="current-password" required placeholder="Your password">
              <button type="button" class="auth-eye" id="login-eye" aria-label="Show/hide password">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
          </div>

          <button type="submit" class="btn btn--primary btn--full" style="margin-top:4px;">
            {{ section.settings.submit_text | default: 'Sign In' }}
          </button>
        {% endform %}

        <div class="auth-divider"><span>or</span></div>

        <a href="{{ routes.account_register_url }}" class="btn btn--ghost btn--full">
          {{ section.settings.create_account_text | default: 'Create Account' }}
        </a>
      </div>

      <!-- Password recovery form (hidden by default) -->
      <div id="auth-recover-form" style="display:none;">
        <div class="auth-brand">
          <p class="section-eyebrow">Account Recovery</p>
          <h1 class="auth-heading">Reset Password</h1>
          <p class="auth-sub">Enter your email and we'll send you a reset link.</p>
        </div>

        {% form 'recover_customer_password', class: 'auth-form' %}
          {% if form.posted_successfully? %}
            <div class="auth-success-banner">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="20 6 9 17 4 12"/></svg>
              <p>Check your inbox — we've sent a reset link to your email.</p>
            </div>
          {% else %}
            {% if form.errors %}
              <div class="auth-error" role="alert">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/></svg>
                <div>{{ form.errors | default_errors }}</div>
              </div>
            {% endif %}

            <div class="auth-field">
              <label class="auth-label" for="recover-email">Email Address</label>
              <input class="auth-input" type="email" name="email" id="recover-email"
                     autocomplete="email" required placeholder="you@email.com">
            </div>

            <button type="submit" class="btn btn--primary btn--full">Send Reset Link</button>
          {% endif %}
        {% endform %}

        <button type="button" class="auth-back-link"
                onclick="document.getElementById('auth-login-form').style.display='block';document.getElementById('auth-recover-form').style.display='none';">
          ← Back to Sign In
        </button>
      </div>

    </div>
  </div>

</div>

<script>
(function () {
  // Password show/hide toggle
  var eye = document.getElementById('login-eye');
  var pwd = document.getElementById('login-password');
  if (eye && pwd) {
    eye.addEventListener('click', function () {
      pwd.type = pwd.type === 'password' ? 'text' : 'password';
    });
  }
  // If recover form was posted, keep it visible
  {% if recover %}
    document.getElementById('auth-login-form').style.display = 'none';
    document.getElementById('auth-recover-form').style.display = 'block';
  {% endif %}
})();
</script>

{% schema %}
{
  "name": "Customer Login",
  "settings": [
    { "type": "header",       "content": "Left Panel" },
    { "type": "image_picker", "id": "panel_image",   "label": "Panel Background Image" },
    { "type": "image_picker", "id": "panel_logo",    "label": "Logo on Panel",
      "info": "White version of your logo. Leave blank to use shop name text." },
    { "type": "text",         "id": "panel_heading", "label": "Panel Heading",
      "default": "Welcome back" },
    { "type": "textarea",     "id": "panel_sub",     "label": "Panel Sub-text",
      "default": "Sign in to access your orders, saved addresses and exclusive member offers." },
    { "type": "header",       "content": "Form" },
    { "type": "text",         "id": "eyebrow",       "label": "Eyebrow",      "default": "My Account" },
    { "type": "text",         "id": "heading",       "label": "Heading",      "default": "Sign In" },
    { "type": "text",         "id": "sub",           "label": "Sub-text",     "default": "Don't have an account?" },
    { "type": "text",         "id": "register_link", "label": "Register Link Text", "default": "Create one" },
    { "type": "text",         "id": "submit_text",   "label": "Submit Button",      "default": "Sign In" },
    { "type": "text",         "id": "create_account_text", "label": "Create Account Button", "default": "Create Account" }
  ]
}
{% endschema %}
