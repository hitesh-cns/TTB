<section class="page-not-found">
  <div class="page-not-found__inner container">
    <h1 class="page-not-found__title">{{ '404.title' | t }}</h1>
    <p class="page-not-found__body">{{ '404.body' | t }}</p>
    <a href="{{ routes.root_url }}" class="btn btn--primary">{{ '404.cta' | t }}</a>
  </div>
</section>

{% schema %}
{
  "name": "404 page",
  "settings": []
}
{% endschema %}

<style>
  .page-not-found {
    padding: 120px 24px;
    text-align: center;
  }
  .page-not-found__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: 16px;
  }
  .page-not-found__body {
    font-size: 1.125rem;
    color: #666;
    margin-bottom: 32px;
  }
</style>
