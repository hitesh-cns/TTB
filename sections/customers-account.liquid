{% if customer %}

<div class="acct-page">
  <div class="container">
    <div class="acct-layout">

      {% render 'account-nav' %}

      <div class="acct-content">
        <div class="acct-content__header">
          <h1 class="acct-heading">My Orders</h1>
          <p class="acct-sub">{{ customer.orders_count }} order{{ customer.orders_count | pluralize: '', 's' }} placed</p>
        </div>

        {% if customer.orders.size > 0 %}
          <div class="orders-table-wrap">
            <table class="orders-table">
              <thead>
                <tr>
                  <th>Order</th>
                  <th>Date</th>
                  <th>Status</th>
                  <th>Items</th>
                  <th>Total</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {% for order in customer.orders %}
                  <tr class="order-row">
                    <td class="order-num">
                      <span>#{{ order.name }}</span>
                    </td>
                    <td class="order-date">{{ order.created_at | date: '%d %b %Y' }}</td>
                    <td>
                      <span class="order-badge order-badge--{{ order.financial_status }}">
                        {{ order.financial_status | replace: '_', ' ' | capitalize }}
                      </span>
                    </td>
                    <td class="order-items-count">{{ order.line_items.size }} item{{ order.line_items.size | pluralize: '', 's' }}</td>
                    <td class="order-total">{{ order.total_price | money }}</td>
                    <td>
                      <a href="{{ order.customer_url }}" class="order-view-btn">View →</a>
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>

        {% else %}
          <div class="acct-empty">
            <div class="acct-empty__icon">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            </div>
            <h3>No orders yet</h3>
            <p>Your beautiful purchases will appear here.</p>
            <a href="/collections/all" class="btn btn--primary">Start Shopping</a>
          </div>
        {% endif %}

        <!-- Profile section -->
        <div class="acct-section" id="profile">
          <h2 class="acct-section__title">Profile &amp; Password</h2>
          <div class="acct-profile-grid">
            <div>
              <p class="acct-field-label">Full Name</p>
              <p class="acct-field-val">{{ customer.first_name }} {{ customer.last_name }}</p>
            </div>
            <div>
              <p class="acct-field-label">Email</p>
              <p class="acct-field-val">{{ customer.email }}</p>
            </div>
            <div>
              <p class="acct-field-label">Phone</p>
              <p class="acct-field-val">{{ customer.phone | default: '—' }}</p>
            </div>
            <div>
              <p class="acct-field-label">Member since</p>
              <p class="acct-field-val">{{ customer.created_at | date: '%B %Y' }}</p>
            </div>
          </div>
          <div class="acct-actions">
            <a href="{{ routes.account_url }}/edit" class="btn btn--ghost btn--sm">Edit Profile</a>
            <a href="/account/login#recover" class="btn btn--ghost btn--sm">Change Password</a>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

{% else %}
  <div class="auth-page">
    <div class="auth-card" style="text-align:center;">
      <p class="section-eyebrow">Account</p>
      <h1 class="auth-heading" style="font-size:28px;">Please Sign In</h1>
      <p class="auth-sub">You need to be logged in to view your account.</p>
      <a href="{{ routes.account_login_url }}" class="btn btn--primary" style="margin-top:20px;display:inline-block;">Sign In</a>
      <div class="auth-divider"><span>New here?</span></div>
      <a href="/account/register" class="btn btn--ghost btn--full">Create Account</a>
    </div>
  </div>
{% endif %}

{% schema %}{ "name": "Customer Account", "settings": [] }{% endschema %}