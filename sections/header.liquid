<script>
(function() {
  const input = document.getElementById('header-search-input');
  const results = document.getElementById('predictive-search-results');
  if (!input || !results) return;

  let debounceTimer;

  input.addEventListener('input', function() {
    clearTimeout(debounceTimer);
    const q = this.value.trim();
    if (q.length < 2) { results.hidden = true; input.setAttribute('aria-expanded','false'); return; }
    debounceTimer = setTimeout(() => fetchPredictive(q), 300);
  });

  input.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') { results.hidden = true; input.setAttribute('aria-expanded','false'); }
  });

  document.addEventListener('click', function(e) {
    if (!e.target.closest('.header-search-bar')) {
      results.hidden = true; input.setAttribute('aria-expanded','false');
    }
  });

  function fetchPredictive(q) {
    const url = `${window.Shopify.routes.root}search/suggest.json?q=${encodeURIComponent(q)}&resources[type]=product,collection,page&resources[limit]=5&resources[options][fields]=title,product_type,variants.title`;
    fetch(url)
      .then(r => r.json())
      .then(data => renderResults(data.resources.results, q))
      .catch(() => {});
  }

  function renderResults(res, q) {
    const products = res.products || [];
    const collections = res.collections || [];
    const pages = res.pages || [];
    const all = [...products, ...collections, ...pages];

    if (all.length === 0) { results.hidden = true; input.setAttribute('aria-expanded','false'); return; }

    results.innerHTML = all.map((item, i) => {
      const img = item.featured_image?.url
        ? `<img src="${item.featured_image.url}&width=60" alt="${item.title}" width="40" height="40" loading="lazy" style="object-fit:cover;border-radius:4px;">`
        : '';
      return `<li class="predictive-search__item" role="option" id="predictive-option-${i}">
        <a href="${item.url}" class="predictive-search__link">
          <span class="predictive-search__img">${img}</span>
          <span class="predictive-search__info">
            <span class="predictive-search__title">${item.title}</span>
            ${item.price ? `<span class="predictive-search__price">${formatMoney(item.price)}</span>` : ''}
          </span>
        </a>
      </li>`;
    }).join('');

    results.hidden = false;
    input.setAttribute('aria-expanded','true');
  }

  function formatMoney(cents) {
    return (cents / 100).toLocaleString(undefined, { style:'currency', currency: window.Shopify.currency.active || 'USD' });
  }
})();
</script>
