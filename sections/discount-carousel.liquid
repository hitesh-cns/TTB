{% comment %}
  ============================================================
  SECTION: DISCOUNT CAROUSEL
  ============================================================
  Discount Carousel — The 'Bundle & Save' section showing the 4 discount tiers.
  Tier discounts (5% / 10% / 15% / 20%) are applied by the Discount Engine (discount-engine.js).
  Products must have the metafield custom.discount = 'BXGY' to qualify.
  EDIT: Theme Editor → Home page → Discount Carousel
  ============================================================
{% endcomment %}
<section class="discount-section" id="discount-section">
  <div class="discount-section__bg"></div>
  <div class="container">
    <div class="discount-section__header">
      <p class="section-eyebrow">{{ section.settings.eyebrow | default: 'Bundle & Save' }}</p>
      <h2 class="section-heading">{{ section.settings.heading | default: 'The More You Love, The More You Save' }}</h2>
      <p class="section-subheading">{{ section.settings.subheading | default: 'Mix and match any items across our collection' }}</p>
    </div>

    <div class="discount-carousel" id="discount-carousel">
      <div class="discount-track" id="discount-track">

        <div class="discount-card" data-qty="2" data-pct="5">
          <div class="discount-card__icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </div>
          <div class="discount-card__qty">Buy 2</div>
          <div class="discount-card__pct">5% Off</div>
          <p class="discount-card__desc">{{ section.settings.tier1_desc | default: 'Perfect starter bundle for the new arrival' }}</p>
          <a href="{{ section.settings.shop_url | default: '/collections/all' }}" class="btn btn--discount">{{ section.settings.shop_btn_text | default: "Shop Now" }}</a>
        </div>

        <div class="discount-card discount-card--featured" data-qty="3" data-pct="10">
          <div class="discount-card__badge">{{ section.settings.popular_badge | default: "Popular" }}</div>
          <div class="discount-card__icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>
          <div class="discount-card__qty">Buy 3</div>
          <div class="discount-card__pct">10% Off</div>
          <p class="discount-card__desc">{{ section.settings.tier2_desc | default: 'Ideal for seasonal wardrobe refresh' }}</p>
          <a href="{{ section.settings.shop_url | default: '/collections/all' }}" class="btn btn--discount">{{ section.settings.shop_btn_text | default: "Shop Now" }}</a>
        </div>

        <div class="discount-card" data-qty="4" data-pct="15">
          <div class="discount-card__icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
          </div>
          <div class="discount-card__qty">Buy 4</div>
          <div class="discount-card__pct">15% Off</div>
          <p class="discount-card__desc">{{ section.settings.tier3_desc | default: 'Build a complete nursery wardrobe' }}</p>
          <a href="{{ section.settings.shop_url | default: '/collections/all' }}" class="btn btn--discount">{{ section.settings.shop_btn_text | default: "Shop Now" }}</a>
        </div>

        <div class="discount-card discount-card--gold" data-qty="5" data-pct="20">
          <div class="discount-card__icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          </div>
          <div class="discount-card__qty">Buy 5+</div>
          <div class="discount-card__pct">20% Off</div>
          <p class="discount-card__desc">{{ section.settings.tier4_desc | default: 'The ultimate luxury gift set or full collection' }}</p>
          <a href="{{ section.settings.shop_url | default: '/collections/all' }}" class="btn btn--discount">{{ section.settings.shop_btn_text | default: "Shop Now" }}</a>
        </div>

      </div>

      <div class="carousel-controls">
        <button class="carousel-btn carousel-btn--prev" id="discount-prev" aria-label="Previous">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <div class="carousel-dots" id="discount-dots"></div>
        <button class="carousel-btn carousel-btn--next" id="discount-next" aria-label="Next">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>
    </div>

    <div class="discount-progress" id="discount-progress">
      <div class="discount-progress__label">
        <span id="discount-progress-text">{{ section.settings.unlock_text | default: "Add items to unlock savings" }}</span>
      </div>
      <div class="discount-progress__bar">
        <div class="discount-progress__fill" id="discount-progress-fill" style="width:0%"></div>
        <div class="discount-progress__markers">
          <span class="progress-marker" style="left:40%">2</span>
          <span class="progress-marker" style="left:60%">3</span>
          <span class="progress-marker" style="left:80%">4</span>
          <span class="progress-marker" style="left:100%">5+</span>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Discount Carousel",
  "settings": [
    { "type": "header",   "content": "Section Text" },
    { "type": "text",     "id": "eyebrow",    "label": "Eyebrow",    "default": "Bundle & Save" },
    { "type": "text",     "id": "heading",    "label": "Heading",    "default": "The More You Love, The More You Save" },
    { "type": "text",     "id": "subheading", "label": "Subheading", "default": "Mix and match any items across our collection" },
    { "type": "url",      "id": "shop_url",   "label": "Shop URL" },
    { "type": "text",     "id": "shop_btn_text","label":"Shop Button Text","default":"Shop Now" },
    { "type": "text",     "id": "popular_badge","label":"'Popular' Badge Text","default":"Popular","info":"Shown on the most-popular tier card." },
    { "type": "text",     "id": "unlock_text", "label": "Unlock Hint Text", "default": "Add items to unlock savings" },
    { "type": "header",   "content": "Tier 1  -  Buy 2" },
    { "type": "text",     "id": "tier1_title", "label": "Tier 1 Label",   "default": "Buy 2" },
    { "type": "text",     "id": "tier1_pct",   "label": "Tier 1 Discount","default": "5% off", "info": "Display text only  -  the actual discount is applied by the discount codes." },
    { "type": "text",     "id": "tier1_desc",  "label": "Tier 1 Description", "default": "Perfect starter bundle for the new arrival" },
    { "type": "header",   "content": "Tier 2  -  Buy 3" },
    { "type": "text",     "id": "tier2_title", "label": "Tier 2 Label",   "default": "Buy 3" },
    { "type": "text",     "id": "tier2_pct",   "label": "Tier 2 Discount","default": "10% off" },
    { "type": "text",     "id": "tier2_desc",  "label": "Tier 2 Description", "default": "Ideal for seasonal wardrobe refresh" },
    { "type": "header",   "content": "Tier 3  -  Buy 4" },
    { "type": "text",     "id": "tier3_title", "label": "Tier 3 Label",   "default": "Buy 4" },
    { "type": "text",     "id": "tier3_pct",   "label": "Tier 3 Discount","default": "15% off" },
    { "type": "text",     "id": "tier3_desc",  "label": "Tier 3 Description", "default": "Build a complete nursery wardrobe" },
    { "type": "header",   "content": "Tier 4  -  Buy 5+" },
    { "type": "text",     "id": "tier4_title", "label": "Tier 4 Label",   "default": "Buy 5+" },
    { "type": "text",     "id": "tier4_pct",   "label": "Tier 4 Discount","default": "20% off" },
    { "type": "text",     "id": "tier4_desc",  "label": "Tier 4 Description", "default": "The ultimate luxury gift set or full collection" }
  ],
  "presets": [{ "name": "Discount Carousel" }]
}
{% endschema %}
