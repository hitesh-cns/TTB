{% comment %}
  ============================================================
  SECTION: CUSTOMERS ADDRESSES
  ============================================================
  Customer Addresses — The /account/addresses page.
  Lets customers add, edit and delete saved shipping addresses.
  EDIT: Theme Editor → Customer pages → Customer Addresses
  ============================================================
{% endcomment %}
{% if customer %}

<div class="acct-page">
  <div class="container">
    <div class="acct-layout">

      {% render 'account-nav' %}

      <div class="acct-content">
        <div class="acct-content__header">
          <h1 class="acct-heading">Saved Addresses</h1>
          <button class="btn btn--primary btn--sm" id="add-addr-btn">+ Add New Address</button>
        </div>

        <!-- Add / edit address form (hidden by default) -->
        <div class="addr-form-wrap" id="addr-form-wrap" style="display:none;">
          <h2 class="addr-form__title" id="addr-form-title">New Address</h2>
          {% form 'customer_address', customer.new_address, class: 'addr-form', id: 'new-addr-form' %}
            <div class="auth-row">
              <div class="auth-field">
                <label class="auth-label">First Name</label>
                <input class="auth-input" type="text" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name">
              </div>
              <div class="auth-field">
                <label class="auth-label">Last Name</label>
                <input class="auth-input" type="text" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name">
              </div>
            </div>
            <div class="auth-field">
              <label class="auth-label">Address Line 1</label>
              <input class="auth-input" type="text" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1" required>
            </div>
            <div class="auth-field">
              <label class="auth-label">Address Line 2 <span class="auth-hint-inline">(optional)</span></label>
              <input class="auth-input" type="text" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2">
            </div>
            <div class="auth-row">
              <div class="auth-field">
                <label class="auth-label">City</label>
                <input class="auth-input" type="text" name="address[city]" value="{{ form.city }}" autocomplete="address-level2" required>
              </div>
              <div class="auth-field">
                <label class="auth-label">PIN Code</label>
                <input class="auth-input" type="text" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code">
              </div>
            </div>
            <div class="auth-row">
              <div class="auth-field">
                <label class="auth-label">State</label>
                <input class="auth-input" type="text" name="address[province]" value="{{ form.province }}" autocomplete="address-level1">
              </div>
              <div class="auth-field">
                <label class="auth-label">Country</label>
                <select class="auth-input auth-select" name="address[country]" autocomplete="country">
                  {{ country_option_tags }}
                </select>
              </div>
            </div>
            <div class="auth-field">
              <label class="auth-label">Phone</label>
              <input class="auth-input" type="tel" name="address[phone]" value="{{ form.phone }}" autocomplete="tel">
            </div>
            <label class="auth-checkbox">
              <input type="checkbox" name="address[default]" value="1" {% if customer.default_address == customer.new_address %}checked{% endif %}>
              <span>Set as default address</span>
            </label>
            <div class="addr-form__actions">
              <button type="submit" class="btn btn--primary">Save Address</button>
              <button type="button" class="btn btn--ghost" id="addr-form-cancel">Cancel</button>
            </div>
          {% endform %}
        </div>

        <!-- Existing addresses -->
        {% if customer.addresses.size > 0 %}
          <div class="addr-grid">
            {% for address in customer.addresses %}
              <div class="addr-card {% if address == customer.default_address %}is-default{% endif %}">
                {% if address == customer.default_address %}
                  <span class="addr-card__badge">Default</span>
                {% endif %}
                <p class="addr-card__name">{{ address.first_name }} {{ address.last_name }}</p>
                <p class="addr-card__line">{{ address.address1 }}</p>
                {% if address.address2 != blank %}<p class="addr-card__line">{{ address.address2 }}</p>{% endif %}
                <p class="addr-card__line">{{ address.city }}{% if address.province != blank %}, {{ address.province }}{% endif %} {{ address.zip }}</p>
                <p class="addr-card__line">{{ address.country }}</p>
                {% if address.phone != blank %}<p class="addr-card__line">{{ address.phone }}</p>{% endif %}
                <div class="addr-card__actions">
                  <a href="{{ routes.account_url }}/addresses/{{ address.id }}" class="addr-action-btn">Edit</a>
                  {% form 'customer_address', address, class: 'addr-delete-form' %}
                    <input type="hidden" name="_method" value="delete">
                    <button type="submit" class="addr-action-btn addr-action-btn--delete"
                            onclick="return confirm('Remove this address?')">Delete</button>
                  {% endform %}
                  {% unless address == customer.default_address %}
                    {% form 'customer_address', address, class: 'addr-default-form' %}
                      <input type="hidden" name="_method" value="put">
                      <input type="hidden" name="address[default]" value="1">
                      <button type="submit" class="addr-action-btn">Set default</button>
                    {% endform %}
                  {% endunless %}
                </div>
              </div>
            {% endfor %}
          </div>
        {% else %}
          <div class="acct-empty">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <h3>No addresses saved</h3>
            <p>Add an address for faster checkout.</p>
          </div>
        {% endif %}

      </div>
    </div>
  </div>
</div>

<script>
(function () {
  const btn = document.getElementById('add-addr-btn');
  const wrap = document.getElementById('addr-form-wrap');
  const cancel = document.getElementById('addr-form-cancel');
  btn && btn.addEventListener('click', () => { wrap.style.display = 'block'; wrap.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
  cancel && cancel.addEventListener('click', () => { wrap.style.display = 'none'; });
})();
</script>

{% else %}
  <div class="auth-page">
    <div class="auth-card" style="text-align:center;">
      <p class="section-eyebrow">Account</p>
      <h1 class="auth-heading" style="font-size:28px;">Please Sign In</h1>
      <p class="auth-sub">You need to be logged in to manage your addresses.</p>
      <a href="/account/login" class="btn btn--primary" style="margin-top:20px;display:inline-block;">Sign In</a>
    </div>
  </div>
{% endif %}

{% schema %}{ "name": "Customer Addresses", "settings": [] }{% endschema %}
