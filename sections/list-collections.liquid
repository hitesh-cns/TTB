<section class="list-collections">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <h1 class="list-collections__title">{{ section.settings.heading }}</h1>
    {%- endif -%}
    <div class="list-collections__grid">
      {%- paginate collections by section.settings.collections_per_page -%}
        {%- for collection in collections -%}
          <a href="{{ collection.url }}" class="list-collections__card">
            {%- if collection.featured_image -%}
              <div class="list-collections__img-wrap">
                {{ collection.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 600, 900', sizes: '(min-width: 768px) 33vw, 50vw', alt: collection.featured_image.alt | default: collection.title }}
              </div>
            {%- else -%}
              <div class="list-collections__img-wrap list-collections__img-wrap--placeholder">
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}
            <h2 class="list-collections__name">{{ collection.title }}</h2>
          </a>
        {%- endfor -%}
        {%- if paginate.pages > 1 -%}
          <div class="list-collections__pagination">{{ paginate | default_pagination }}</div>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "All collections" },
    { "type": "range", "id": "collections_per_page", "label": "Collections per page", "min": 8, "max": 48, "step": 4, "default": 16 }
  ],
  "presets": [{ "name": "Collections list" }]
}
{% endschema %}

<style>
.list-collections { padding: 60px 24px; }
.list-collections__title { font-family: var(--font-display); font-size: clamp(1.75rem,4vw,3rem); text-align: center; margin-bottom: 40px; }
.list-collections__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 24px; }
.list-collections__card { text-decoration: none; color: inherit; display: block; }
.list-collections__img-wrap { aspect-ratio: 1; overflow: hidden; background: #f5f5f5; margin-bottom: 12px; }
.list-collections__img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
.list-collections__card:hover img { transform: scale(1.04); }
.list-collections__name { font-family: var(--font-display); font-size: 1.1rem; }
.list-collections__pagination { grid-column: 1 / -1; text-align: center; margin-top: 24px; }
</style>
