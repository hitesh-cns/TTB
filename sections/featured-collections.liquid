{% comment %}
  ============================================================
  SECTION: FEATURED COLLECTIONS
  ============================================================
  Featured Collections — Displays collection tiles in a grid.
  Each tile links to a collection and shows its image, title and a CTA.
  HOW TO ADD TILES: Theme Editor → Featured Collections → Add block → Collection Tile
    - Pick a collection → its image and title load automatically
    - Override the image, label or link URL per block if needed
  EDIT: Theme Editor → Home page → Featured Collections
  ============================================================
{% endcomment %}
<section class="featured-collections section-spacing">
  <div class="container">

    <div class="section-header">
      {% if section.settings.eyebrow != blank %}
        <p class="section-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="section-heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="section-subheading">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}

      <div class="collections-grid collections-grid--{{ section.blocks.size }}">
        {% for block in section.blocks %}
          {% assign col = collections[block.settings.collection] %}
          <div class="collection-card" {{ block.shopify_attributes }}>
            <a href="{% if block.settings.url != blank %}{{ block.settings.url }}{% elsif col != blank %}{{ col.url }}{% else %}/collections/all{% endif %}" class="collection-card__link">
              <div class="collection-card__image-wrap">
                {% if block.settings.image != blank %}
                  <img src="{{ block.settings.image | img_url: '800x' }}" alt="{{ block.settings.label | default: col.title }}" class="collection-card__image" loading="lazy">
                {% elsif col != blank and col.image %}
                  <img src="{{ col.image | img_url: '800x' }}" alt="{{ col.title }}" class="collection-card__image" loading="lazy">
                {% else %}
                  <div class="collection-card__placeholder">
                    {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                {% endif %}
                <div class="collection-card__overlay"></div>
              </div>
              <div class="collection-card__content">
                <h3 class="collection-card__title">
                  {{ block.settings.label | default: col.title | default: 'Collection' }}
                </h3>
                {% if block.settings.subtitle != blank %}
                  <p class="collection-card__subtitle">{{ block.settings.subtitle }}</p>
                {% endif %}
                <span class="collection-card__cta">
                  {{ section.settings.cta_label | default: 'Explore' }}
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
              </div>
            </a>
          </div>
        {% endfor %}
      </div>

    {% else %}

      {%- comment -%} Editor placeholder — shown only in Theme Editor when no blocks are added {%- endcomment -%}
      <div class="fc-empty-state">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
        <p><strong>No collections added yet.</strong></p>
        <p>Click <em>"Add block"</em> in the sidebar, then select a collection for each tile you want to display.</p>
      </div>

    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Featured Collections",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "collection",
      "name": "Collection Tile",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Select a collection. Its title and image will be used automatically."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Tile Image",
          "info": "Overrides the collection's own image."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Tile Label",
          "info": "Overrides the collection title. Leave blank to use collection title."
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Tile Subtitle",
          "info": "Optional short description below the title."
        },
        {
          "type": "url",
          "id": "url",
          "label": "Custom Link URL",
          "info": "Overrides the collection link. Leave blank to use the collection URL."
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Our Collections"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Section Sub-heading",
      "info": "Optional line below the heading."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Tile CTA Text",
      "default": "Explore",
      "info": "Text shown on every tile's button."
    }
  ],
  "presets": [{
    "name": "Featured Collections",
    "blocks": [
      { "type": "collection" },
      { "type": "collection" },
      { "type": "collection" }
    ]
  }]
}
{% endschema %}
