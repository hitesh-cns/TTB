{% comment %}
  ============================================================
  SECTION: PAGE CONTACT
  ============================================================
  Contact Page — Used by the /pages/contact URL.
  Contains: hero, contact form (powered by Shopify's built-in form), contact info cards.
  Submissions go to your Shopify Admin → Orders → Inbox.
  EDIT: Theme Editor → Pages → Contact Us
  ============================================================
{% endcomment %}
<div class="be-page">

  <!-- Hero -->
  <div class="be-page__hero">
    <div class="container">
      <p class="section-eyebrow">{{ section.settings.eyebrow | default: "We'd Love to Hear From You" }}</p>
      <h1 class="be-page__title">{{ section.settings.heading | default: 'Contact Us' }}</h1>
      <p class="be-page__sub">{{ section.settings.subheading | default: 'Our team is here Monday–Saturday, 9am–6pm IST. We typically respond within 24 hours.' }}</p>
    </div>
  </div>

  <div class="container">
    <div class="contact-layout">

      <!-- Form -->
      <div class="contact-form-col">
        <h2 class="contact-col-title">{{ section.settings.form_heading | default: "Send a Message" }}</h2>
        {% form 'contact', class: 'contact-form', id: 'contact-form' %}
          {% if form.posted_successfully? %}
            <div class="contact-success">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              <div>
                <p><strong>Message received!</strong></p>
                <p>We'll get back to you within 24 hours.</p>
              </div>
            </div>
          {% endif %}
          {% if form.errors %}
            <div class="auth-error" role="alert">{{ form.errors | default_errors }}</div>
          {% endif %}

          <div class="auth-row">
            <div class="auth-field">
              <label class="auth-label" for="ct-name">{{ section.settings.label_name | default: "Your Name" }} *</label>
              <input class="auth-input" type="text" name="contact[name]" id="ct-name" required placeholder="Priya Sharma">
            </div>
            <div class="auth-field">
              <label class="auth-label" for="ct-email">Email Address *</label>
              <input class="auth-input" type="email" name="contact[email]" id="ct-email" required placeholder="your@email.com">
            </div>
          </div>

          <div class="auth-field">
            <label class="auth-label" for="ct-subject">Subject</label>
            <select class="auth-input auth-select" name="contact[subject]" id="ct-subject">
              <option value="">Select a topic…</option>
              <option>{{ section.settings.topic_order | default: "Order Query" }}</option>
              <option>Return / Exchange</option>
              <option>{{ section.settings.topic_product | default: "Product Question" }}</option>
              <option>Wholesale / Bulk Order</option>
              <option>Something Else</option>
            </select>
          </div>

          <div class="auth-field">
            <label class="auth-label" for="ct-order">Order Number <span class="auth-hint-inline">(if applicable)</span></label>
            <input class="auth-input" type="text" name="contact[order_number]" id="ct-order" placeholder="#1234">
          </div>

          <div class="auth-field">
            <label class="auth-label" for="ct-message">Message *</label>
            <textarea class="auth-input auth-textarea" name="contact[body]" id="ct-message" rows="5" required placeholder="Tell us how we can help…"></textarea>
          </div>

          <button type="submit" class="btn btn--primary">Send Message</button>
        {% endform %}
      </div>

      <!-- Info -->
      <div class="contact-info-col">
        <h2 class="contact-col-title">Get in Touch</h2>

        <div class="contact-info-cards">
          {% if section.settings.email != blank %}
            <div class="contact-info-card">
              <div class="contact-info-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </div>
              <div>
                <p class="contact-info-label">Email</p>
                <a href="mailto:{{ section.settings.email }}" class="contact-info-val">{{ section.settings.email }}</a>
              </div>
            </div>
          {% endif %}

          {% if section.settings.phone != blank %}
            <div class="contact-info-card">
              <div class="contact-info-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </div>
              <div>
                <p class="contact-info-label">Phone / WhatsApp</p>
                <a href="tel:{{ section.settings.phone }}" class="contact-info-val">{{ section.settings.phone }}</a>
              </div>
            </div>
          {% endif %}

          {% if section.settings.address != blank %}
            <div class="contact-info-card">
              <div class="contact-info-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div>
                <p class="contact-info-label">Studio Address</p>
                <p class="contact-info-val">{{ section.settings.address }}</p>
              </div>
            </div>
          {% endif %}

          <div class="contact-info-card">
            <div class="contact-info-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div>
              <p class="contact-info-label">Hours</p>
              <p class="contact-info-val">{{ section.settings.hours | default: 'Monday – Saturday, 9am – 6pm IST' }}</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

</div>

{% schema %}
{
  "name": "Contact Page",
  "settings": [
    { "type": "text", "id": "form_heading", "label": "Form Heading", "default": "Send a Message" },
    { "type": "text", "id": "topic_product", "label": "Topic Product", "default": "Product Question" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "We'd Love to Hear From You" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact Us" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Our team is here Monday-Saturday, 9am-6pm IST. We typically respond within 24 hours." },
    { "type": "text", "id": "email", "label": "Email Address", "default": "hello@yourstore.com" },
    { "type": "text", "id": "phone", "label": "Phone / WhatsApp", "default": "+91 98765 43210" },
    { "type": "text", "id": "address", "label": "Studio Address" },
    { "type": "text", "id": "hours",        "label": "Business Hours",     "default": "Monday - Saturday, 9am - 6pm IST" },
    { "type": "header", "content": "Form Labels" },
    { "type": "text",   "id": "label_name",   "label": "Name Field Label",   "default": "Your Name" },
    { "type": "text",   "id": "topic_order",  "label": "Topic Option 1",     "default": "Order Query" }
  ]
}
{% endschema %}
