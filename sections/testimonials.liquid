<section class="testimonials-section section-spacing" style="{% if section.settings.bg_color != blank %}background:{{ section.settings.bg_color }};{% endif %}">
  <div class="testimonials-bg"></div>
  <div class="container">
    <div class="section-header section-header--center">
      {% if section.settings.eyebrow != blank %}
        <p class="section-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="section-heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="section-subheading">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="testimonials-carousel" id="testimonials-carousel">
      <div class="testimonials-track" id="testimonials-track">
        {% for block in section.blocks %}
          <div class="testimonial-card" {{ block.shopify_attributes }}>
            <div class="testimonial-quote-mark">"</div>
            <blockquote class="testimonial-text">{{ block.settings.quote }}</blockquote>
            <div class="testimonial-footer">
              {% if block.settings.avatar != blank %}
                <div class="testimonial-avatar">
                  <img src="{{ block.settings.avatar | image_url: width: 100, height: 100, crop: 'center' }}" alt="{{ block.settings.name }}">
                </div>
              {% else %}
                <div class="testimonial-avatar testimonial-avatar--initials">
                  {{ block.settings.name | slice: 0, 1 }}
                </div>
              {% endif %}
              <div class="testimonial-author">
                <p class="testimonial-name">{{ block.settings.name }}</p>
                {% if block.settings.subtitle != blank %}
                  <p class="testimonial-subtitle">{{ block.settings.subtitle }}</p>
                {% endif %}
                <div class="testimonial-stars">
                  {% assign stars = block.settings.rating | default: 5 %}
                  {% for i in (1..stars) %}★{% endfor %}
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="testimonial-controls">
        <button class="carousel-btn carousel-btn--prev" id="testimonials-prev" aria-label="Previous">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <div class="carousel-dots" id="testimonials-dots"></div>
        <button class="carousel-btn carousel-btn--next" id="testimonials-next" aria-label="Next">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Absolutely beautiful quality. The fabrics are so soft  -  my baby looks like royalty."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer Name",
          "default": "Sophie M."
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Location / Tag",
          "default": "Mama of 2, Mumbai"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar Photo",
          "info": "Optional. Shows initials if blank."
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Star Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Testimonials"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Words from Our Little Family"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sub-heading",
      "info": "Optional line below the heading."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Colour",
      "info": "Leave blank to use the default ivory background."
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        }
      ]
    }
  ]
}
{% endschema %}
