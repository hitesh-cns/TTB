{% comment %}
  ============================================================
  SECTION: MAIN PAGE (generic)
  ============================================================
  Fallback page section for any Shopify Page not assigned one of
  the theme's dedicated page templates (About / Contact / FAQ /
  Returns). Route stub — this route previously had no theme
  template file, so Shopify rendered its own built-in default
  page. Reproduces that: just the page title and rich-text body.
  EDIT: Theme Editor → Pages → (any page using the default template)
  ============================================================
{% endcomment %}
<div class="container" style="padding: 40px 20px;">
  <h1>{{ page.title }}</h1>
  <div class="rte">{{ page.content }}</div>
</div>

{% schema %}
{
  "name": "Main Page",
  "settings": [],
  "presets": [
    { "name": "Main Page" }
  ]
}
{% endschema %}
