{% comment %}
  ============================================================
  SECTION: HERO BANNER
  ============================================================
  Hero Banner — The large full-width image section at the top of the home page.
  Shows a background image with an overlay heading, sub-text and two CTA buttons.
  EDIT: Theme Editor → Home page → Hero Banner
  ============================================================
{% endcomment %}
<section class="hero-section hero-section--{{ section.settings.height | default: 'large' }}" id="hero-section" style="--hero-overlay: {{ section.settings.overlay_opacity | default: 40 }}%;">
  {% if section.settings.image != blank %}
    <div class="hero-bg" loading="eager" fetchpriority="high">
      {%- if section.settings.image_mobile != blank -%}
        <picture>
          <source media="(max-width: 767px)" srcset="{{ section.settings.image_mobile | img_url: '800x' }} 800w, {{ section.settings.image_mobile | img_url: '1200x' }} 1200w" sizes="100vw">
          <img
            src="{{ section.settings.image | img_url: '2000x' }}"
            srcset="{{ section.settings.image | img_url: '800x' }} 800w, {{ section.settings.image | img_url: '1200x' }} 1200w, {{ section.settings.image | img_url: '2000x' }} 2000w"
            sizes="100vw"
            alt="{{ section.settings.image.alt | default: shop.name }}"
            class="hero-image"
            loading="eager"
            fetchpriority="high"
          >
        </picture>
      {%- else -%}
        <img
          src="{{ section.settings.image | img_url: '2000x' }}"
          srcset="{{ section.settings.image | img_url: '800x' }} 800w, {{ section.settings.image | img_url: '1200x' }} 1200w, {{ section.settings.image | img_url: '2000x' }} 2000w"
          sizes="100vw"
          alt="{{ section.settings.image.alt | default: shop.name }}"
          class="hero-image"
          loading="eager"
          fetchpriority="high"
        >
      {%- endif -%}
    </div>
  {% else %}
    <div class="hero-bg hero-bg--placeholder"></div>
  {% endif %}

  <div class="hero-overlay"></div>

  <div class="hero-content hero-content--{{ section.settings.content_position | default: 'center' }} container">
    <div class="hero-text-block hero-text-block--{{ section.settings.text_align | default: 'left' }}">
      {% if section.settings.eyebrow != blank %}
        <p class="hero-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h1 class="hero-heading">{{ section.settings.heading }}</h1>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="hero-subheading">{{ section.settings.subheading }}</p>
      {% endif %}
      <div class="hero-ctas hero-ctas--{{ section.settings.btn_position | default: 'inherit' }}">
        {% if section.settings.cta_1_text != blank %}
          <a href="{{ section.settings.cta_1_url }}" class="btn btn--primary">{{ section.settings.cta_1_text }}</a>
        {% endif %}
        {% if section.settings.cta_2_text != blank %}
          <a href="{{ section.settings.cta_2_url }}" class="btn btn--outline">{{ section.settings.cta_2_text }}</a>
        {% endif %}
      </div>
    </div>
  </div>

  {% if section.settings.show_scroll != false %}<div class="hero-scroll-indicator">
    <div class="scroll-line"></div>
    <span>{{ section.settings.scroll_label | default: "Scroll" }}</span>
  </div>{% endif %}
</section>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "settings": [
    { "type": "header",       "content": "Image" },
    { "type": "image_picker", "id": "image",        "label": "Hero Image (Desktop)",
      "info": "Recommended: 2000×900px. The focal point should be centred." },
    { "type": "image_picker", "id": "image_mobile", "label": "Hero Image (Mobile)",
      "info": "Optional. Recommended: 800×1000px portrait. Falls back to desktop image." },
    { "type": "select",       "id": "height",        "label": "Hero Height",
      "options": [
        { "value": "small",   "label": "Small  (400px)"  },
        { "value": "medium",  "label": "Medium (550px)"  },
        { "value": "large",   "label": "Large  (700px)"  },
        { "value": "full",    "label": "Full viewport"   }
      ], "default": "large" },
    { "type": "range",        "id": "overlay_opacity", "label": "Image Overlay Darkness",
      "min": 0, "max": 80, "step": 5, "unit": "%", "default": 40,
      "info": "Higher = darker overlay so text stands out more." },
    { "type": "header",       "content": "Content" },
    { "type": "select",       "id": "text_align",    "label": "Text Alignment",
      "options": [
        { "value": "left",   "label": "Left"   },
        { "value": "center", "label": "Centre" },
        { "value": "right",  "label": "Right"  }
      ], "default": "left" },
    { "type": "select",       "id": "btn_position", "label": "Button Alignment",
      "options": [
        { "value": "inherit", "label": "Follow text alignment" },
        { "value": "left",    "label": "Left"   },
        { "value": "center",  "label": "Centre" },
        { "value": "right",   "label": "Right"  },
        { "value": "stack",   "label": "Stacked (full width)" }
      ], "default": "inherit",
      "info": "Controls where the buttons sit. 'Follow text alignment' matches your text setting." },
    { "type": "select",       "id": "content_position", "label": "Content Vertical Position",
      "options": [
        { "value": "top",    "label": "Top"    },
        { "value": "center", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" }
      ], "default": "center" },
    { "type": "text",         "id": "eyebrow",    "label": "Eyebrow Text",
      "default": "New Collection",
      "info": "Small uppercase label above the heading. Leave blank to hide." },
    { "type": "text",         "id": "heading",    "label": "Main Heading",
      "default": "Dressed in Softness, Wrapped in Love" },
    { "type": "select",       "id": "heading_size", "label": "Heading Size",
      "options": [
        { "value": "small",  "label": "Small"  },
        { "value": "medium", "label": "Medium" },
        { "value": "large",  "label": "Large"  }
      ], "default": "large" },
    { "type": "textarea",     "id": "subheading", "label": "Sub-heading",
      "default": "Premium organic cotton pieces for your little ones  -  gentle on skin, beautiful in every stitch." },
    { "type": "header",       "content": "Buttons" },
    { "type": "text",         "id": "cta_1_text", "label": "Primary Button Text",   "default": "Shop Now" },
    { "type": "url",          "id": "cta_1_url",  "label": "Primary Button URL" },
    { "type": "text",         "id": "cta_2_text", "label": "Secondary Button Text", "default": "View Lookbook" },
    { "type": "url",          "id": "cta_2_url",  "label": "Secondary Button URL" },
    { "type": "header",       "content": "Scroll Indicator" },
    { "type": "checkbox",     "id": "show_scroll", "label": "Show Scroll Indicator", "default": true },
    { "type": "text",         "id": "scroll_label","label": "Scroll Text",           "default": "Scroll" }
  ],
  "presets": [{ "name": "Hero Banner" }]
}
{% endschema %}