{% comment %}
  ============================================================
  SECTION: MULTI-COLUMN (Icon + Text Cards)
  ============================================================
  A 2–4 column grid of cards. Each card has:
  - Icon (emoji or SVG option), image, heading, text, link
  Perfect for: features, USPs, shipping info, how-it-works.
  EDIT: Theme Editor → Add section → Multi Column
  ============================================================
{% endcomment %}
<section class="multi-col-section section-spacing" style="background:{{ section.settings.bg_color | default: 'transparent' }};">
  <div class="container">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="section-header section-header--center">
        {%- if section.settings.eyebrow != blank -%}<p class="section-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="section-heading">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<p class="section-subheading">{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="multi-col-grid multi-col-grid--{{ section.settings.columns }} multi-col-grid--style-{{ section.settings.card_style }}">
      {%- for block in section.blocks -%}
        <div class="multi-col-card multi-col-card--align-{{ block.settings.align | default: section.settings.default_align }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="multi-col-card__img-wrap">
              <img src="{{ block.settings.image | img_url: '600x' }}" alt="{{ block.settings.heading }}" loading="lazy" class="multi-col-card__img">
            </div>
          {%- elsif block.settings.icon_emoji != blank -%}
            <div class="multi-col-card__icon" style="font-size:{{ section.settings.icon_size | default: 40 }}px;">
              {{ block.settings.icon_emoji }}
            </div>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h3 class="multi-col-card__heading">{{ block.settings.heading }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="multi-col-card__text rte">{{ block.settings.text }}</div>
          {%- endif -%}
          {%- if block.settings.cta_text != blank -%}
            <a href="{{ block.settings.cta_url | default: '#' }}" class="multi-col-card__link">
              {{ block.settings.cta_text }} →
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Multi Column",
  "max_blocks": 6,
  "blocks": [{
    "type": "column",
    "name": "Column",
    "settings": [
      { "type": "image_picker", "id": "image",      "label": "Image (optional)"   },
      { "type": "text",         "id": "icon_emoji", "label": "Icon (emoji)",
        "info": "Used when no image is set. E.g. 🚚 🌿 ♻️ 💛" },
      { "type": "text",         "id": "heading",    "label": "Heading" },
      { "type": "richtext",     "id": "text",       "label": "Body Text" },
      { "type": "text",         "id": "cta_text",   "label": "Link Text" },
      { "type": "url",          "id": "cta_url",    "label": "Link URL" },
      { "type": "select",       "id": "align",      "label": "Override Alignment",
        "options": [{"value":"","label":"Use section default"},{"value":"left","label":"Left"},{"value":"center","label":"Centre"}],
        "default": "" }
    ]
  }],
  "settings": [
    { "type": "text",   "id": "eyebrow",    "label": "Eyebrow" },
    { "type": "text",   "id": "heading",    "label": "Section Heading" },
    { "type": "textarea","id":"subheading", "label": "Section Sub-heading" },
    { "type": "select", "id": "columns",    "label": "Columns",
      "options": [{"value":"2","label":"2"},{"value":"3","label":"3"},{"value":"4","label":"4"}],
      "default": "3" },
    { "type": "select", "id": "card_style", "label": "Card Style",
      "options": [
        {"value":"plain",   "label":"Plain (no background)"},
        {"value":"bordered","label":"Bordered"},
        {"value":"filled",  "label":"Filled (ivory background)"},
        {"value":"shadow",  "label":"Shadow card"}
      ], "default": "plain" },
    { "type": "select", "id": "default_align","label": "Default Alignment",
      "options": [{"value":"left","label":"Left"},{"value":"center","label":"Centre"}],
      "default": "center" },
    { "type": "range",  "id": "icon_size",  "label": "Icon Size (px)", "min": 24, "max": 80, "step": 4, "default": 40 },
    { "type": "color",  "id": "bg_color",   "label": "Section Background" }
  ],
  "presets": [{ "name": "Multi Column",
    "blocks": [{"type":"column"},{"type":"column"},{"type":"column"}] }]
}
{% endschema %}
