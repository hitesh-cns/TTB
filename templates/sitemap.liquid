{% layout none %}<?xml version="1.0" encoding="UTF-8"?>
{%- comment -%}
  ============================================================
  SITEMAP.XML — Auto-generated XML sitemap
  ============================================================
  Shopify serves this at: yourstore.com/sitemap.xml
  It is submitted to Google Search Console to help Google
  discover and index all pages, collections, products and
  blog posts.

  HOW TO SUBMIT:
  1. Go to Google Search Console → Sitemaps
  2. Enter: sitemap.xml
  3. Click Submit

  NOTE: Shopify also auto-generates a sitemap at /sitemap.xml
  by default. This template gives you a custom version you can
  extend or audit.
  ============================================================
{%- endcomment -%}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">

  {%- comment -%} -- Home page -- {%- endcomment -%}
  <url>
    <loc>{{ shop.url }}/</loc>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>

  {%- comment -%} -- Static pages (About, Contact, FAQ, Returns) -- {%- endcomment -%}
  {% for page in pages %}
    <url>
      <loc>{{ shop.url }}{{ page.url }}</loc>
      <lastmod>{{ page.updated_at | date: '%Y-%m-%d' }}</lastmod>
      <changefreq>monthly</changefreq>
      <priority>0.6</priority>
    </url>
  {% endfor %}

  {%- comment -%} -- Collections -- {%- endcomment -%}
  {% for collection in collections %}
    {% unless collection.handle == 'frontpage' %}
      <url>
        <loc>{{ shop.url }}{{ collection.url }}</loc>
        <lastmod>{{ collection.updated_at | date: '%Y-%m-%d' }}</lastmod>
        <changefreq>weekly</changefreq>
        <priority>0.8</priority>
        {% if collection.image %}
          <image:image>
            <image:loc>https:{{ collection.image | img_url: '1200x' }}</image:loc>
            <image:title>{{ collection.title | xml_escape }}</image:title>
          </image:image>
        {% endif %}
      </url>
    {% endunless %}
  {% endfor %}

  {%- comment -%} -- Products (all published, up to 5 images each for Google Images) -- {%- endcomment -%}
  {% paginate products by 500 %}
    {% for product in products %}
      <url>
        <loc>{{ shop.url }}{{ product.url }}</loc>
        <lastmod>{{ product.updated_at | date: '%Y-%m-%d' }}</lastmod>
        <changefreq>weekly</changefreq>
        <priority>0.9</priority>
        {% for image in product.images limit: 5 %}
          <image:image>
            <image:loc>https:{{ image | img_url: '1200x' }}</image:loc>
            <image:title>{{ product.title | xml_escape }}{% if image.alt %} — {{ image.alt | xml_escape }}{% endif %}</image:title>
          </image:image>
        {% endfor %}
      </url>
    {% endfor %}
  {% endpaginate %}

  {%- comment -%} -- Blog articles -- {%- endcomment -%}
  {% for blog in blogs %}
    <url>
      <loc>{{ shop.url }}{{ blog.url }}</loc>
      <changefreq>weekly</changefreq>
      <priority>0.6</priority>
    </url>
    {% for article in blog.articles %}
      <url>
        <loc>{{ shop.url }}{{ article.url }}</loc>
        <lastmod>{{ article.updated_at | date: '%Y-%m-%d' }}</lastmod>
        <changefreq>monthly</changefreq>
        <priority>0.7</priority>
        {% if article.image %}
          <image:image>
            <image:loc>https:{{ article.image | img_url: '1200x' }}</image:loc>
            <image:title>{{ article.title | xml_escape }}</image:title>
          </image:image>
        {% endif %}
      </url>
    {% endfor %}
  {% endfor %}

</urlset>
