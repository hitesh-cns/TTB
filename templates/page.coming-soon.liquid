{% layout none %}
<!DOCTYPE html>
<html lang="{{ request.locale.iso_code | default: 'en' }}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ shop.name }} — Coming Soon</title>
  <meta name="description" content="Something extraordinary is almost here. Join the list for early access and exclusive offers." />
  <meta name="robots" content="noindex, nofollow" />
  {{ content_for_header }}

  <!-- Match exact theme fonts -->

  <style>
    /* ── EXACT THEME TOKENS ── */
    :root {
      --font-display: 'Cormorant Garamond', Georgia, serif;
      --font-body:    'DM Sans', 'Helvetica Neue', sans-serif;
      --white:   #ffffff;
      --off:     #faf8f5;
      --pearl:   #f2efe9;
      --stone:   #e0dbd3;
      --mid:     #9a958f;
      --ink:     #1a1a1a;
      --black:   #000000;
      --blush-line: rgba(0,0,0,0.08);
    }

    /* ── RESET ── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    /* ── LOCK VIEWPORT — NO SCROLL ── */
    html, body {
      height: 100%; width: 100%;
      overflow: hidden;
      background: var(--white);
      color: var(--black);
      font-family: var(--font-body);
      -webkit-font-smoothing: antialiased;
    }

    /* ── SUBTLE WARM BACKGROUND WASH ── */
    body::before {
      content: '';
      position: fixed; inset: 0;
      pointer-events: none; z-index: 0;
      background:
        radial-gradient(ellipse 80% 60% at 105% -10%, rgba(255,230,200,0.22) 0%, transparent 60%),
        radial-gradient(ellipse 60% 70% at -10% 110%, rgba(240,220,200,0.15) 0%, transparent 55%);
    }

    /* ── THIN DECORATIVE VERTICAL LINES ── */
    .deco-lines {
      position: fixed; inset: 0;
      pointer-events: none; z-index: 0;
      overflow: hidden;
    }
    .deco-lines::before,
    .deco-lines::after {
      content: '';
      position: absolute; top: 0; bottom: 0;
      width: 1px;
      background: linear-gradient(to bottom, transparent 0%, var(--stone) 30%, var(--stone) 70%, transparent 100%);
    }
    .deco-lines::before { left: clamp(3rem, 8vw, 7rem); opacity: 0.5; }
    .deco-lines::after  { right: clamp(3rem, 8vw, 7rem); opacity: 0.5; }

    /* ── FULL-HEIGHT PAGE GRID ── */
    .page {
      position: relative; z-index: 10;
      height: 100vh;
      display: grid;
      grid-template-rows: auto 1fr auto;
    }

    /* ────────── HEADER ────────── */
    .cs-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: clamp(1.4rem, 3vh, 2.2rem) clamp(2rem, 6vw, 5rem);
      border-bottom: 1px solid var(--blush-line);
      animation: fadeDown 0.8s ease both;
    }

    .cs-logo {
      font-family: var(--font-display);
      font-size: clamp(1.4rem, 3vw, 1.9rem);
      font-weight: 400;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--black);
    }

    .cs-badge {
      font-family: var(--font-body);
      font-size: 0.65rem;
      font-weight: 400;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--mid);
    }

    /* ────────── MAIN ────────── */
    main {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      padding: clamp(2rem, 4vh, 3rem) clamp(2rem, 6vw, 5rem);
      max-width: 1280px;
      width: 100%;
      margin: 0 auto;
      gap: clamp(2rem, 5vw, 5rem);
      overflow: hidden;
    }

    /* ── LEFT COLUMN ── */
    .col-left { display: flex; flex-direction: column; }

    .eyebrow {
      font-family: var(--font-body);
      font-size: 0.62rem;
      font-weight: 500;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--mid);
      margin-bottom: clamp(1rem, 2vh, 1.8rem);
      display: flex; align-items: center; gap: 0.8rem;
      animation: fadeUp 0.8s 0.15s ease both;
    }
    .eyebrow-dot {
      width: 5px; height: 5px; border-radius: 50%;
      background: var(--black); flex-shrink: 0;
    }

    .hero-headline {
      font-family: var(--font-display);
      font-weight: 300;
      font-size: clamp(3.5rem, 7.5vw, 7rem);
      line-height: 0.9;
      letter-spacing: -0.01em;
      color: var(--black);
      animation: fadeUp 0.9s 0.25s ease both;
    }
    .hero-headline em {
      font-style: italic;
      font-weight: 300;
      color: var(--ink);
    }
    .hero-headline .serif-rule {
      display: block;
      width: 3.5rem; height: 1.5px;
      background: var(--black);
      margin: 1.2rem 0 1rem;
    }

    .hero-sub {
      font-family: var(--font-body);
      font-size: clamp(0.78rem, 1.3vw, 0.88rem);
      font-weight: 300;
      line-height: 1.8;
      color: var(--mid);
      letter-spacing: 0.04em;
      max-width: 34ch;
      margin-bottom: clamp(1.5rem, 3vh, 2.5rem);
      animation: fadeUp 0.9s 0.35s ease both;
    }

    /* ── EMAIL FORM ── */
    .form-section {
      animation: fadeUp 0.9s 0.45s ease both;
      max-width: 420px;
    }
    .form-label {
      font-family: var(--font-body);
      display: block;
      font-size: 0.6rem;
      font-weight: 500;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--ink);
      margin-bottom: 0.75rem;
    }
    .form-row {
      display: flex;
      border: 1px solid var(--ink);
      overflow: hidden;
      background: var(--white);
      transition: border-color 0.25s, box-shadow 0.25s;
    }
    .form-row:focus-within {
      border-color: var(--black);
      box-shadow: 0 0 0 2px rgba(0,0,0,0.08);
    }
    input[type="email"] {
      flex: 1;
      background: transparent; border: none; outline: none;
      padding: 0.9rem 1.1rem;
      font-family: var(--font-body);
      font-size: 0.85rem; font-weight: 300;
      letter-spacing: 0.04em;
      color: var(--black);
      caret-color: var(--black);
    }
    input[type="email"]::placeholder { color: var(--mid); font-weight: 300; }

    .btn-submit {
      background: var(--black);
      color: var(--white);
      border: none;
      padding: 0 1.6rem;
      font-family: var(--font-body);
      font-size: 0.6rem;
      font-weight: 600;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      cursor: pointer;
      transition: background 0.25s;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .btn-submit:hover  { background: var(--ink); }
    .btn-submit:active { transform: scale(0.98); }

    .form-note {
      margin-top: 0.65rem;
      font-size: 0.6rem; font-weight: 300;
      letter-spacing: 0.1em;
      color: var(--mid);
    }
    .form-note a { color: var(--mid); text-decoration: underline; text-underline-offset: 3px; }

    .success-msg {
      display: none; align-items: center; gap: 0.7rem;
      padding: 0.85rem 1rem;
      background: var(--pearl);
      border: 1px solid var(--stone);
      color: var(--ink);
      font-family: var(--font-body);
      font-size: 0.65rem; font-weight: 400;
      letter-spacing: 0.18em; text-transform: uppercase;
      margin-top: 0.85rem;
    }
    .success-msg.show { display: flex; animation: fadeUp 0.4s ease both; }

    /* ── RIGHT COLUMN ── */
    .col-right {
      display: flex; flex-direction: column;
      align-items: flex-start; justify-content: center;
      padding-left: clamp(2rem, 4vw, 4rem);
      border-left: 1px solid var(--blush-line);
      animation: fadeUp 0.9s 0.2s ease both;
    }

    .col-right-label {
      font-family: var(--font-body);
      font-size: 0.6rem; font-weight: 500;
      letter-spacing: 0.28em; text-transform: uppercase;
      color: var(--mid); margin-bottom: 1.5rem;
    }

    /* ── COUNTDOWN ── */
    .countdown-wrap {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
      width: 100%;
      margin-bottom: clamp(2rem, 4vh, 3.5rem);
    }
    .count-block {
      display: flex; flex-direction: column;
      align-items: center; gap: 0.4rem;
      padding: 1.2rem 0.5rem;
      border-right: 1px solid var(--blush-line);
      border-bottom: 1px solid var(--blush-line);
      border-top: 1px solid var(--blush-line);
    }
    .count-block:first-child { border-left: 1px solid var(--blush-line); }
    .count-num {
      font-family: var(--font-display);
      font-weight: 300;
      font-size: clamp(2rem, 3.5vw, 3.2rem);
      line-height: 1;
      color: var(--black);
      min-width: 2ch; text-align: center;
    }
    .count-label {
      font-family: var(--font-body);
      font-size: 0.5rem; font-weight: 500;
      letter-spacing: 0.25em; text-transform: uppercase;
      color: var(--mid);
    }

    /* ── SOCIAL LINKS IN RIGHT COL ── */
    .social-block { width: 100%; }
    .social-label {
      font-family: var(--font-body);
      font-size: 0.58rem; font-weight: 500;
      letter-spacing: 0.25em; text-transform: uppercase;
      color: var(--mid); margin-bottom: 1rem;
      display: block;
    }
    .social-links {
      display: flex; gap: 0;
    }
    .social-links a {
      display: flex; align-items: center; gap: 0.45rem;
      padding: 0.65rem 1.1rem;
      font-family: var(--font-body);
      font-size: 0.6rem; font-weight: 500;
      letter-spacing: 0.2em; text-transform: uppercase;
      color: var(--black); text-decoration: none;
      border: 1px solid var(--blush-line);
      transition: background 0.2s, border-color 0.2s;
      margin-right: -1px; /* collapse borders */
    }
    .social-links a:hover { background: var(--pearl); border-color: var(--stone); z-index: 1; position: relative; }
    .social-links a svg { width: 12px; height: 12px; flex-shrink: 0; }

    /* ────────── FOOTER ────────── */
    .cs-footer {
      display: flex; justify-content: space-between; align-items: center;
      padding: clamp(1rem, 2vh, 1.5rem) clamp(2rem, 6vw, 5rem);
      border-top: 1px solid var(--blush-line);
      animation: fadeUp 0.8s 0.6s ease both;
    }
    .cs-copy {
      font-size: 0.58rem; font-weight: 300;
      letter-spacing: 0.15em; color: var(--mid);
      text-transform: uppercase;
    }
    .cs-tagline {
      font-family: var(--font-display);
      font-size: 0.85rem; font-style: italic;
      font-weight: 300; color: var(--mid);
      letter-spacing: 0.05em;
    }

    /* ────────── ANIMATIONS ────────── */
    @keyframes fadeUp   { from{opacity:0;transform:translateY(18px)} to{opacity:1;transform:translateY(0)} }
    @keyframes fadeDown { from{opacity:0;transform:translateY(-12px)} to{opacity:1;transform:translateY(0)} }

    /* ────────── RESPONSIVE ────────── */
    @media (max-width: 768px) {
      main {
        grid-template-columns: 1fr;
        gap: 2rem;
        padding-top: 1.5rem;
        padding-bottom: 1.5rem;
        overflow-y: auto;
      }
      html, body { overflow: auto; }
      .col-right {
        padding-left: 0; border-left: none;
        border-top: 1px solid var(--blush-line);
        padding-top: 2rem;
      }
      .deco-lines { display: none; }
      .cs-tagline { display: none; }
      .hero-headline { font-size: clamp(3rem, 12vw, 5rem); }
      .countdown-wrap { max-width: 360px; }
    }

    @media (max-height: 720px) and (min-width: 769px) {
      .hero-headline { font-size: clamp(2.8rem, 6vw, 5.5rem); }
      .hero-sub { margin-bottom: 1.2rem; }
      .col-right-label { margin-bottom: 0.8rem; }
      .count-block { padding: 0.8rem 0.5rem; }
      .countdown-wrap { margin-bottom: 1.5rem; }
    }
  </style>
  {{ settings.font_heading | font_face: font_display: 'swap' }}
  {{ settings.font_body | font_face: font_display: 'swap' }}
  <style>
    :root {
      --font-display: {{ settings.font_heading.family | json }}, Georgia, serif;
      --font-body: {{ settings.font_body.family | json }}, 'Helvetica Neue', sans-serif;
    }
  </style>
</head>
<body>

  <div class="deco-lines"></div>

  <div class="page">

    <!-- ── HEADER ── -->
    <header class="cs-header">
      <div class="cs-logo">{{ shop.name }}</div>
      <div class="cs-badge">SS&thinsp;27 &nbsp;·&nbsp; New Collection</div>
    </header>

    <!-- ── MAIN ── -->
    <main>

      <!-- LEFT: Headline + Form -->
      <div class="col-left">

        <div class="eyebrow">
          <span class="eyebrow-dot"></span>
          Coming Soon
        </div>

        <h1 class="hero-headline">
          Something<br/>
          <em>Beautiful</em><br/>
          <span class="serif-rule"></span>
          Is Coming
        </h1>

        <p class="hero-sub">
          Our SS27 collection is taking shape.<br/>
          Be the first to discover new arrivals,<br/>
          exclusive early access &amp; launch offers.
        </p>

        <div class="form-section">
          <label class="form-label" for="cs-email">Get notified at launch</label>
          <div class="form-row" id="form-row">
            <input
              type="email"
              id="cs-email"
              placeholder="Enter your email address"
              autocomplete="email"
              spellcheck="false"
            />
            <button class="btn-submit" id="cs-submit" type="button">Notify Me</button>
          </div>
          <p class="form-note">
            No spam, ever. Unsubscribe anytime. &nbsp;
            <a href="/pages/privacy-policy">Privacy Policy</a>
          </p>
          <div class="success-msg" id="cs-success">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            You're on the list — we'll be in touch soon.
          </div>
        </div>

      </div>

      <!-- RIGHT: Countdown + Social -->
      <div class="col-right">

        <div class="col-right-label">Launching in</div>

        <div class="countdown-wrap">
          <div class="count-block">
            <span class="count-num" id="cd-days">00</span>
            <span class="count-label">Days</span>
          </div>
          <div class="count-block">
            <span class="count-num" id="cd-hours">00</span>
            <span class="count-label">Hours</span>
          </div>
          <div class="count-block">
            <span class="count-num" id="cd-mins">00</span>
            <span class="count-label">Mins</span>
          </div>
          <div class="count-block">
            <span class="count-num" id="cd-secs">00</span>
            <span class="count-label">Secs</span>
          </div>
        </div>

        <div class="social-block">
          <span class="social-label">Follow us</span>
          <div class="social-links">
            <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5"/>
                <circle cx="12" cy="12" r="4.5"/>
                <circle cx="17.5" cy="6.5" r="0.7" fill="currentColor" stroke="none"/>
              </svg>
              Instagram
            </a>
            <a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">
              <svg viewBox="0 0 24 24" fill="currentColor" stroke="none">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V9a8.19 8.19 0 0 0 4.79 1.53V7.07a4.85 4.85 0 0 1-1.02-.38z"/>
              </svg>
              TikTok
            </a>
            <a href="{{ settings.social_pinterest }}" target="_blank" rel="noopener" aria-label="Pinterest">
              <svg viewBox="0 0 24 24" fill="currentColor" stroke="none">
                <path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/>
              </svg>
              Pinterest
            </a>
          </div>
        </div>

      </div>

    </main>

    <!-- ── FOOTER ── -->
    <footer class="cs-footer">
      <div class="cs-copy">© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</div>
      <div class="cs-tagline">Dressed for the ones who matter most.</div>
    </footer>

  </div>

  <script>
    /* ── COUNTDOWN — Summer 2027 ── */
    const LAUNCH = new Date('2027-06-21T10:00:00');
    function pad(n){ return String(n).padStart(2,'0'); }
    function tick(){
      const diff = LAUNCH - new Date();
      if(diff <= 0){
        ['cd-days','cd-hours','cd-mins','cd-secs'].forEach(id=>{
          document.getElementById(id).textContent = '00';
        });
        return;
      }
      document.getElementById('cd-days').textContent  = pad(Math.floor(diff / 86400000));
      document.getElementById('cd-hours').textContent = pad(Math.floor((diff % 86400000) / 3600000));
      document.getElementById('cd-mins').textContent  = pad(Math.floor((diff % 3600000) / 60000));
      document.getElementById('cd-secs').textContent  = pad(Math.floor((diff % 60000) / 1000));
    }
    tick(); setInterval(tick, 1000);

    /* ── EMAIL FORM ── */
    document.getElementById('cs-submit').addEventListener('click', function(){
      const input   = document.getElementById('cs-email');
      const row     = document.getElementById('form-row');
      const success = document.getElementById('cs-success');
      const email   = input.value.trim();

      if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){
        row.style.borderColor = '#cc3333';
        input.focus();
        setTimeout(()=>{ row.style.borderColor = ''; }, 1600);
        return;
      }

      /* Shopify newsletter endpoint */
      fetch('/contact#newsletter', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: 'form_type=customer&utf8=✓&contact[email]=' + encodeURIComponent(email) + '&contact[tags]=coming-soon-ss27'
      });

      row.style.display = 'none';
      success.classList.add('show');
    });

    /* Allow submit on Enter key */
    document.getElementById('cs-email').addEventListener('keydown', function(e){
      if(e.key === 'Enter') document.getElementById('cs-submit').click();
    });
  </script>

</body>
</html>
