  </main>

  <!-- FOOTER -->

  <footer>
    <div class="footer-copy">© 2026 TTB. All rights reserved.</div>
    <nav class="footer-social">
      <a href="#">Instagram</a>
      <a href="#">TikTok</a>
      <a href="#">Pinterest</a>
    </nav>
  </footer>

