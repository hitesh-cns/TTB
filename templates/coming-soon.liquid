<script>
  /* ─── COUNTDOWN TIMER ─── */
  // Set your launch date here (YYYY, MM-1, DD, HH, MM, SS)
  const LAUNCH = new Date('2026-06-21T10:00:00');

  function pad(n){ return String(n).padStart(2,'0'); }

  function tick(){
    const now  = new Date();
    const diff = LAUNCH - now;
    if(diff <= 0){
      document.getElementById('cd-days').textContent  = '00';
      document.getElementById('cd-hours').textContent = '00';
      document.getElementById('cd-mins').textContent  = '00';
      document.getElementById('cd-secs').textContent  = '00';
      return;
    }
    const days  = Math.floor(diff / 86400000);
    const hours = Math.floor((diff % 86400000) / 3600000);
    const mins  = Math.floor((diff % 3600000) / 60000);
    const secs  = Math.floor((diff % 60000) / 1000);

    document.getElementById('cd-days').textContent  = pad(days);
    document.getElementById('cd-hours').textContent = pad(hours);
    document.getElementById('cd-mins').textContent  = pad(mins);
    document.getElementById('cd-secs').textContent  = pad(secs);
  }
  tick();
  setInterval(tick, 1000);

  /* ─── EMAIL FORM ─── */
  document.getElementById('submit-btn').addEventListener('click', function(){
    const input   = document.getElementById('email-input');
    const success = document.getElementById('success-msg');
    const email   = input.value.trim();

    // Basic validation
    const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if(!re.test(email)){
      input.style.outline = 'none';
      input.parentElement.style.borderColor = 'rgba(200,60,60,0.5)';
      input.focus();
      setTimeout(()=>{ input.parentElement.style.borderColor = ''; }, 1500);
      return;
    }

    // Hide form, show success
    input.parentElement.style.display = 'none';
    success.classList.add('show');

    /*
     * Shopify Integration Note:
     * Replace this block with a fetch() call to your Shopify Customer API
     * or a Klaviyo / Mailchimp webhook endpoint, e.g.:
     *
     * fetch('/contact#newsletter', {
     *   method: 'POST',
     *   headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
     *   body: `form_type=customer&email=${encodeURIComponent(email)}&tags=coming-soon`
     * });
     */
  });
</script>

